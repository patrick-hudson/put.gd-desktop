{
  "schemaVersion": 1,
  "purpose": "Screen recording runtime inside the AppImage: putgd-record's GStreamer capture plugins and its private FFmpeg export libraries (docs/recording.md, packaging/appimage/README.md). Host GPU encoders come first; the bundled x264/x265 are the fallback. The image is a GPL-2.0-or-later combined work; its corresponding source is the release's appimage-media-source asset (tools/releases/appimage_media_sources.py).",
  "gstreamer": {
    "plugins": [
      "coreelements",
      "videotestsrc",
      "videoconvertscale",
      "videorate",
      "videocrop",
      "audioconvert",
      "audioresample",
      "ximagesrc",
      "pipewire",
      "pulseaudio",
      "matroska",
      "audioparsers",
      "videoparsersbad",
      "va",
      "vaapi",
      "x264",
      "voaacenc"
    ],
    "requiredElements": [
      "ximagesrc",
      "pipewiresrc",
      "pulsesrc",
      "videoconvert",
      "videorate",
      "videocrop",
      "matroskamux",
      "h264parse",
      "aacparse",
      "voaacenc",
      "x264enc"
    ]
  },
  "hostLibraries": [
    "libva.so.*",
    "libva-drm.so.*",
    "libva-x11.so.*",
    "libva-wayland.so.*",
    "libpipewire-0.3.so.*",
    "libopenh264.so.*",
    "libcuda.so.*",
    "libnvidia-encode.so.*"
  ],
  "hostFallbackLibraries": [
    "libva.so.2",
    "libva-drm.so.2"
  ],
  "gplLibraries": [
    "libx264.so.*",
    "libx265.so.*"
  ],
  "gplSourcePackages": [
    "gst-plugins-ugly1.0"
  ],
  "ffmpeg": {
    "license": "GPL-2.0-or-later",
    "configure": [
      "--enable-shared",
      "--disable-static",
      "--enable-pic",
      "--disable-programs",
      "--disable-avdevice",
      "--disable-doc",
      "--disable-debug",
      "--disable-autodetect",
      "--disable-everything",
      "--disable-network",
      "--disable-xlib",
      "--enable-gpl",
      "--enable-pthreads",
      "--enable-avcodec",
      "--enable-avformat",
      "--enable-avfilter",
      "--enable-swscale",
      "--enable-swresample",
      "--enable-vaapi",
      "--enable-ffnvcodec",
      "--enable-nvenc",
      "--enable-libvpx",
      "--enable-libwebp",
      "--enable-libopus",
      "--enable-libx264",
      "--enable-libx265",
      "--enable-protocol=file",
      "--enable-demuxer=matroska",
      "--enable-muxer=mp4,webm,gif,webp,matroska",
      "--enable-decoder=h264,aac",
      "--enable-parser=h264,aac,vp9,opus",
      "--enable-bsfs",
      "--enable-encoder=h264_vaapi,hevc_vaapi,h264_nvenc,hevc_nvenc,libx264,libx265,libvpx_vp9,gif,libwebp_anim,aac,libopus",
      "--enable-filter=buffer,buffersink,abuffer,abuffersink,null,anull,trim,atrim,setpts,asetpts,format,aformat,aresample,scale,crop,avgblur,drawbox,split,overlay,fps,palettegen,paletteuse"
    ]
  }
}
