#!/bin/sh
# AppImage supplies APPDIR and APPIMAGE. Do not replace the user's settings paths.
set -eu
appdir=${APPDIR:-$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)}
host_library_path=${LD_LIBRARY_PATH-}
host_plugin_path=${QT_PLUGIN_PATH-}
host_cache() {
    LD_LIBRARY_PATH="$host_library_path" QT_PLUGIN_PATH="$host_plugin_path" \
        kbuildsycoca6 --noincremental >/dev/null 2>&1
}
export LD_LIBRARY_PATH="$appdir/usr/lib:$appdir/usr/lib/putgd${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export QT_PLUGIN_PATH="$appdir/usr/plugins:$appdir/usr/lib/qt6/plugins${QT_PLUGIN_PATH:+:$QT_PLUGIN_PATH}"
host_has_library() {
    for tool in ldconfig /sbin/ldconfig /usr/sbin/ldconfig; do
        if command -v "$tool" >/dev/null 2>&1; then
            "$tool" -p 2>/dev/null | awk -v want="$1" '$1 == want && /x86-64/ { found = 1 } END { exit !found }'
            return
        fi
    done
    return 1
}
# libva must match the host's VA drivers, so screen recording uses the host's;
# the bundled copy is added only on a host without one. putgd-record confines
# its bundled GStreamer to the image itself, so nothing else inherits that.
if [ -d "$appdir/usr/lib/putgd-host-fallback" ] && ! host_has_library libva.so.2; then
    LD_LIBRARY_PATH="$LD_LIBRARY_PATH:$appdir/usr/lib/putgd-host-fallback"
fi
# Identity queries are headless; they need no host desktop registration.
if [ "$#" -eq 1 ]; then
    case $1 in
        --version|--version-json|-v) exec "$appdir/usr/bin/putgd-launcher" "$@" ;;
    esac
fi
applications=${XDG_DATA_HOME:-"$HOME/.local/share"}/applications
permission_entry=
record_entry=
ui_icon_entry=
record_icon_entry=
kde=
child=
# This launch's identity (PID and start time): written into every entry it
# adds, so cleanup removes only its own, and a later launch can tell an entry
# left by a killed launch from one a running launch still needs.
process_identity() {
    stat=$(cat "/proc/$1/stat" 2>/dev/null) || return 1
    identity_pid=$1
    # "pid (comm) state ...": comm may hold spaces; start time is field 22.
    set -- ${stat##*') '}
    printf '%s %s' "$identity_pid" "${20}"
}
owner=$(process_identity "$$") || owner=
entry_owner() {
    sed -n 's/^X-PutGD-AppImage-Owner=//p' "$1" 2>/dev/null
}
desktop_escape() {
    printf '%s' "$1" | sed 's/[\\"$`]/\\&/g; s/%/%%/g'
}
cleanup() {
    for entry in ${ui_icon_entry:+"$ui_icon_entry"} ${record_icon_entry:+"$record_icon_entry"}; do
        if [ -n "$owner" ] && [ "$(entry_owner "$entry")" = "$owner" ]; then
            rm -f -- "$entry"
        fi
    done
    if [ -n "$permission_entry$record_entry" ]; then
        rm -f -- ${permission_entry:+"$permission_entry"} ${record_entry:+"$record_entry"}
    fi
    if [ -n "$kde" ] && [ -n "$permission_entry$record_entry$ui_icon_entry$record_icon_entry" ]; then
        host_cache || :
    fi
}
trap cleanup EXIT
# Remove entries whose launch no longer runs (it was killed before cleanup).
# Entries without this launcher's owner key are never touched.
remove_stale_entries() {
    for entry in "$applications"/putgd-ui.desktop "$applications"/putgd-record.desktop \
        "$applications"/putgd-appimage-*.desktop "$applications"/putgd-record-appimage-*.desktop; do
        [ -f "$entry" ] || continue
        recorded=$(entry_owner "$entry")
        case $recorded in
            ''|*[!0-9\ ]*) continue ;;
        esac
        if [ "$(process_identity "${recorded%% *}")" != "$recorded" ]; then
            rm -f -- "$entry"
        fi
    done
}
host_has_entry() {
    [ -e "$applications/$1" ] && return 0
    old_ifs=$IFS
    IFS=:
    set -f
    for directory in ${XDG_DATA_DIRS:-/usr/local/share:/usr/share}; do
        if [ -e "$directory/applications/$1" ]; then
            IFS=$old_ifs
            set +f
            return 0
        fi
    done
    IFS=$old_ifs
    set +f
    return 1
}
# A Wayland compositor finds a window's icon in the desktop entry named by its
# app ID; Qt 6.8 cannot send one with the window. Add NoDisplay entries for the
# windowed helpers' app IDs while this mount runs, unless the host has them
# (a DEB/RPM install, or another running launch). `ln` publishes the complete
# entry and fails rather than replace one that appeared meanwhile.
icon_entry() {
    [ -x "$appdir/usr/bin/$1" ] || return 0
    host_has_entry "$1.desktop" && return 0
    icon=$appdir/usr/share/icons/hicolor/scalable/apps/putgd.svg
    [ -f "$icon" ] || return 0
    target=${APPIMAGE:-"$appdir/AppRun"}
    case $icon$target in
        *'
'*) return 0 ;;
    esac
    staged=$(umask 077; mktemp "$applications/.putgd-icon-XXXXXXXX") || return 0
    printf '[Desktop Entry]\nType=Application\nName=%s\nExec="%s"\nIcon=%s\nNoDisplay=true\nStartupWMClass=%s\nX-PutGD-AppImage-Owner=%s\n' \
        "$2" "$(desktop_escape "$target")" "$(printf '%s' "$icon" | sed 's/\\/\\\\/g')" "$1" "$owner" >"$staged"
    if ln -- "$staged" "$applications/$1.desktop" 2>/dev/null; then
        rm -f -- "$staged"
        printf '%s' "$applications/$1.desktop"
    else
        rm -f -- "$staged"
    fi
}
case ${XDG_CURRENT_DESKTOP:-} in
    *KDE*|*Plasma*) kde=1 ;;
esac
wayland=
if [ -n "${WAYLAND_DISPLAY:-}" ] || [ "${XDG_SESSION_TYPE:-}" = wayland ]; then
    wayland=1
fi
if [ -n "$kde$wayland" ]; then
    mkdir -p -- "$applications"
    remove_stale_entries
fi
if [ -n "$wayland" ] && [ -n "$owner" ]; then
    ui_icon_entry=$(icon_entry putgd-ui put.gd)
    record_icon_entry=$(icon_entry putgd-record 'put.gd screen recorder')
fi
# KWin authorizes the *resident executable*, not the outer AppImage launcher.
# Register only the current mount; never overwrite an existing desktop entry.
if [ -n "$kde" ]; then
    if ! command -v kbuildsycoca6 >/dev/null 2>&1; then
        printf '%s\n' 'put.gd requires kbuildsycoca6 for native KDE capture.' >&2
        exit 1
    fi
    permission_entry=$(umask 077; mktemp "$applications/putgd-appimage-XXXXXXXX.desktop")
    printf '[Desktop Entry]\nType=Application\nName=put.gd AppImage capture\nExec="%s"\nIcon=putgd\nNoDisplay=true\nX-KDE-DBUS-Restricted-Interfaces=org.kde.KWin.ScreenShot2\nX-PutGD-AppImage-Owner=%s\n' \
        "$(desktop_escape "$appdir/usr/bin/putgd")" "$owner" >"$permission_entry"
    # KWin offers its screencast protocol only to an executable whose own
    # entry lists it, so the mounted recorder gets a second entry.
    if [ -x "$appdir/usr/bin/putgd-record" ]; then
        record_entry=$(umask 077; mktemp "$applications/putgd-record-appimage-XXXXXXXX.desktop")
        printf '[Desktop Entry]\nType=Application\nName=put.gd AppImage screen recorder\nExec="%s"\nIcon=putgd\nNoDisplay=true\nX-KDE-Wayland-Interfaces=zkde_screencast_unstable_v1\nX-PutGD-AppImage-Owner=%s\n' \
            "$(desktop_escape "$appdir/usr/bin/putgd-record")" "$owner" >"$record_entry"
    fi
    if ! host_cache; then
        printf '%s\n' 'put.gd could not register native KDE capture permission.' >&2
        exit 1
    fi
fi
# Without host entries to remove (X11 Cinnamon/GNOME), avoid a supervisor.
if [ -z "$permission_entry$ui_icon_entry$record_icon_entry" ]; then
    exec "$appdir/usr/bin/putgd-launcher" "$@"
fi
# Waiting keeps the mount and its host entries alive; forward termination
# to this exact child, then remove only the entries created by this launch.
"$appdir/usr/bin/putgd-launcher" "$@" &
child=$!
trap 'kill -TERM "$child" 2>/dev/null || :; wait "$child" || :; exit 143' TERM HUP
trap 'kill -TERM "$child" 2>/dev/null || :; wait "$child" || :; exit 130' INT
status=0
wait "$child" || status=$?
exit "$status"
