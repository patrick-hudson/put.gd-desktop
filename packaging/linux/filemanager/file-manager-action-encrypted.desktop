# "Upload encrypted with put.gd" in PCManFM and PCManFM-Qt (#2119), beside
# "Upload with put.gd": one FileManager-Actions entry per file. PCManFM-Qt runs
# ShowIfTrue through the shell at every menu and hides the entry while put.gd's
# marker says the destination can't encrypt (#2136, src/filemanager/encrypted-entry.h);
# PCManFM (libfm) ignores ShowIfTrue and shows it. A relative XDG_DATA_HOME
# means ~/.local/share.
[Desktop Entry]
Type=Action
Name=Upload encrypted with put.gd
Icon=putgd
Profiles=putgd;

[X-Action-Profile putgd]
MimeTypes=all/all;
ShowIfTrue=case "$XDG_DATA_HOME" in /*) d=$XDG_DATA_HOME ;; *) d=$HOME/.local/share ;; esac; test ! -e "$d/putgd/file-manager/encrypted-entry-hidden"
Exec=/usr/bin/putgd-launcher --upload --encrypt -- %F
