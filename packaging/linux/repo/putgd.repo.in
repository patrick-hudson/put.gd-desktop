# put.gd @PUTGD_REPO_CHANNEL@ packages from pkg.put.gd, added by the putgd package.
# To stop updates from this repository, delete this file or set enabled=0;
# upgrades leave your change alone and `dnf remove putgd` removes the file.
# $releasever picks the build for this Fedora release, so a system upgrade
# moves put.gd to the next release's build too.
[putgd-@PUTGD_REPO_CHANNEL@]
name=put.gd (@PUTGD_REPO_CHANNEL@)
baseurl=@PUTGD_REPO_URL@/rpm/fedora/$releasever/x86_64/@PUTGD_REPO_CHANNEL@
enabled=1
gpgcheck=1
repo_gpgcheck=0
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-putgd-@PUTGD_REPO_CHANNEL@
metadata_expire=6h
# A Fedora release with no put.gd repository yet warns instead of stopping dnf.
skip_if_unavailable=1
