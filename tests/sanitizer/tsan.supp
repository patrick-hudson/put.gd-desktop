# D-Bus 1.14.10: a newly allocated, unpublished connection is locked under the
# global bus lock during construction. Qt uses dbus_bus_get_private; this new
# mutex cannot be acquired by another thread at that construction edge. TSan
# combines that edge with later disconnect and reports a hypothetical cycle.
# Reproduced with QDBusConnection::sessionBus alone and instrumented libdbus.
# See docs/testing/thread-sanitizer.md. Do not suppress Qt/app races or the lock detector.
deadlock:_dbus_connection_new_for_transport

# GStreamer, FFmpeg (libav*), libcurl, OpenSSL and the AWS SDK are distribution builds without TSan. Their threads
# synchronize with atomics TSan cannot see, so run with TSAN_OPTIONS=ignore_noninstrumented_modules=1 (the
# interceptors, such as malloc and pthread_mutex_lock, then report only for calls from instrumented code).
# That is an option, not a suppression: put.gd's own code is checked as before.

# Qt 6.4 internals found by the race hunt, none involving put.gd code in the racing accesses.
# QNetworkAccessManager starts its HTTP thread and then connects to that QThread's started() signal from the
# calling thread (qnetworkreplyhttpimpl.cpp postRequest); the new thread emits started() and reads the
# connection list with a relaxed load (qobject.cpp maybeSignalConnected) while connect() publishes it
# under the signal mutex. Qt designed the list to be read that way.
race:QThread::started
# A QNetworkReply is deleted on its own thread while the access manager's HTTP thread still runs the
# QObject destructor chain of the delegate (vptr report in ~QNetworkReply / ~QObject).
race:QNetworkReply::~QNetworkReply
# QtDBus owns a thread (QDBusConnectionManager) that dispatches posted events while the main thread runs
# ~QCoreApplication at process exit and clears QCoreApplication::self.
race:QCoreApplication::~QCoreApplication
# The same QtDBus thread destroys QDBusPendingCallWatcherHelper (vptr reset) while it finishes a call.
race:QDBusPendingCallWatcherHelper::~QDBusPendingCallWatcherHelper
# QtDBus completes a call on its own thread (QDBusConnectionPrivate::processFinishedCall moves the reply message
# and appends to the pending-call list) and the calling thread reads them in sendWithReply after its wait.
race:QDBusConnectionPrivate::processFinishedCall
race:QDBusConnectionPrivate::sendWithReply
