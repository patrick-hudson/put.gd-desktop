run("${CMAKE_COMMAND}" -S "${source}" -B "${x11_build}" -G Ninja -DPUTGD_VERSION_FIXTURE_KDE_HELPER=OFF -DPUTGD_VERSION_FIXTURE_CAPTURE_HELPER=ON)
run("${CMAKE_COMMAND}" --build "${x11_build}" --parallel 1)
run("${CMAKE_COMMAND}" --install "${x11_build}" --prefix "${TEST_ROOT}/x11-only-installed")
file(READ "${TEST_ROOT}/x11-only-installed/share/putgd/build-info.json" x11_manifest)
check_binaries("${TEST_ROOT}/x11-only-installed/bin" "${x11_manifest}" OFF ON)
if(EXISTS "${TEST_ROOT}/x11-only-installed/bin/putgd-kde-region")
  message(FATAL_ERROR "X11-only installation unexpectedly contains KDE helper")
endif()
run("${CMAKE_CPACK_COMMAND}" --config "${x11_build}/CPackConfig.cmake" -G TGZ -B "${TEST_ROOT}/x11-only-package")
message(STATUS "Version contract passed: exact clean release tags, native package ordering, product executable identities, stale UI/KDE/X11 helper rejection, absent-helper builds, commits, dirty state, package snapshots and source archives")
