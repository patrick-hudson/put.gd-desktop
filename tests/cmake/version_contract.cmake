function(run)
  execute_process(COMMAND ${ARGV} RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT code EQUAL 0)
    message(FATAL_ERROR "Command failed (${code}): ${ARGV}\n${out}\n${err}")
  endif()
endfunction()
function(check_json json key expected)
  string(JSON actual GET "${json}" "${key}")
  if(NOT "${actual}" STREQUAL "${expected}")
    message(FATAL_ERROR "${key}: expected '${expected}', got '${actual}'")
  endif()
endfunction()
function(read_manifest output)
  file(READ "${TEST_ROOT}/build/build-identity/build-info.json" value)
  set(${output} "${value}" PARENT_SCOPE)
endfunction()
function(check_binaries directory manifest)
  string(JSON expected_version GET "${manifest}" version)
  set(programs putgd putgd-cli putgd-ui)
  if(ARGC EQUAL 2 OR ARGV2)
    list(APPEND programs putgd-kde-region)
  endif()
  if(ARGC LESS 4 OR ARGV3)
    list(APPEND programs putgd-capture)
  endif()
  foreach(program IN LISTS programs)
    execute_process(COMMAND "${directory}/${program}" --version
      RESULT_VARIABLE code OUTPUT_VARIABLE version OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT code EQUAL 0 OR NOT version STREQUAL "${program} ${expected_version}")
      message(FATAL_ERROR "${program} did not refresh its compiled version: ${version}")
    endif()
    execute_process(COMMAND "${directory}/${program}" --version-json
      RESULT_VARIABLE code OUTPUT_VARIABLE embedded)
    if(NOT code EQUAL 0 OR NOT "${embedded}" STREQUAL "${manifest}\n")
      message(FATAL_ERROR "${program} compiled manifest differs from installed manifest input")
    endif()
  endforeach()
endfunction()
function(check_asset path expected)
  file(READ "${path}" actual)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Installed runtime asset differs from the compiled snapshot: ${path}")
  endif()
endfunction()
