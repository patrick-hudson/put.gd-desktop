cmake_minimum_required(VERSION 3.24)
if(NOT DEFINED REPO_ROOT OR NOT DEFINED TEST_ROOT)
  message(FATAL_ERROR "REPO_ROOT and an isolated TEST_ROOT are required")
endif()
find_program(GIT_EXECUTABLE git REQUIRED)
function(run)
  execute_process(COMMAND ${ARGV} RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT code EQUAL 0)
    message(FATAL_ERROR "Command failed (${code}): ${ARGV}\n${out}\n${err}")
  endif()
endfunction()
function(check_json json key expected)
  string(JSON actual GET "${json}" "${key}")
  if(NOT "${actual}" STREQUAL "${expected}")
    message(FATAL_ERROR "${key}: expected '${expected}', got '${actual}'")
  endif()
endfunction()
function(read_manifest output)
  file(READ "${TEST_ROOT}/build/build-identity/build-info.json" value)
  set(${output} "${value}" PARENT_SCOPE)
endfunction()
function(check_binaries directory manifest)
  string(JSON expected_version GET "${manifest}" version)
  set(programs putgd putgd-cli putgd-ui)
  if(ARGC EQUAL 2 OR ARGV2)
    list(APPEND programs putgd-kde-region)
  endif()
  foreach(program IN LISTS programs)
    execute_process(COMMAND "${directory}/${program}" --version
      RESULT_VARIABLE code OUTPUT_VARIABLE version OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT code EQUAL 0 OR NOT version STREQUAL "${program} ${expected_version}")
      message(FATAL_ERROR "${program} did not refresh its compiled version: ${version}")
    endif()
    execute_process(COMMAND "${directory}/${program}" --manifest
      RESULT_VARIABLE code OUTPUT_VARIABLE embedded)
    if(NOT code EQUAL 0 OR NOT "${embedded}" STREQUAL "${manifest}\n")
      message(FATAL_ERROR "${program} compiled manifest differs from installed manifest input")
    endif()
  endforeach()
endfunction()
function(check_asset path expected)
  file(READ "${path}" actual)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Installed runtime asset differs from the compiled snapshot: ${path}")
  endif()
endfunction()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_id)
set(TEST_ROOT "${TEST_ROOT}/${run_id}")
message(STATUS "Version contract artifacts: ${TEST_ROOT}")
file(MAKE_DIRECTORY "${TEST_ROOT}/source/cmake" "${TEST_ROOT}/source/src/core")
file(COPY "${REPO_ROOT}/cmake/BuildVersion.cmake" "${REPO_ROOT}/cmake/GenerateBuildInfo.cmake"
  "${REPO_ROOT}/cmake/BuildInfo.cpp.in" "${REPO_ROOT}/cmake/CheckBuildIdentity.cmake.in"
  "${REPO_ROOT}/cmake/PackageBuildIdentity.cmake.in" "${REPO_ROOT}/cmake/InstallPackageSnapshot.cmake"
  DESTINATION "${TEST_ROOT}/source/cmake")
file(COPY "${REPO_ROOT}/src/core/BuildInfo.h" DESTINATION "${TEST_ROOT}/source/src/core")
file(WRITE "${TEST_ROOT}/source/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.24)
project(version_fixture VERSION 0.1.1 LANGUAGES CXX)
include(GNUInstallDirs)
include(cmake/BuildVersion.cmake)
include(cmake/InstallPackageSnapshot.cmake)
option(PUTGD_VERSION_FIXTURE_KDE_HELPER "Include a dependency-free KDE helper identity fixture" ON)
set(programs putgd putgd-cli putgd-ui)
if(PUTGD_VERSION_FIXTURE_KDE_HELPER)
  list(APPEND programs putgd-kde-region)
endif()
foreach(name IN LISTS programs)
  add_executable(${name} main.cpp)
  target_link_libraries(${name} PRIVATE putgd_build_identity)
  target_compile_definitions(${name} PRIVATE PROGRAM_NAME="${name}")
  install(TARGETS ${name} RUNTIME DESTINATION bin)
endforeach()
putgd_install_snapshot(runtime-asset.js share/putgd)
configure_file(cmake/PackageBuildIdentity.cmake.in package-identity.cmake @ONLY)
set(CPACK_PROJECT_CONFIG_FILE "${CMAKE_CURRENT_BINARY_DIR}/package-identity.cmake")
set(CPACK_PACKAGE_NAME putgd)
set(CPACK_PACKAGE_CONTACT "Version contract <version@example.invalid>")
set(CPACK_DEBIAN_FILE_NAME DEB-DEFAULT)
include(CPack)
]=])
file(WRITE "${TEST_ROOT}/source/main.cpp" [=[
#include "core/BuildInfo.h"
#include <cstdio>
#include <cstring>
int main(int argc, char **argv) {
  if (argc == 2 && std::strcmp(argv[1], "--manifest") == 0)
    std::puts(putgd::buildManifestJson());
  else std::printf("%s %s\n", PROGRAM_NAME, putgd::buildVersion());
}
]=])
set(source "${TEST_ROOT}/source")
set(build "${TEST_ROOT}/build")
set(first_asset "// Synthetic runtime asset from the built revision.\n")
set(second_asset "// Synthetic runtime asset from the next revision.\n")
file(WRITE "${source}/runtime-asset.js" "${first_asset}")
run("${GIT_EXECUTABLE}" -C "${source}" init -q)
run("${GIT_EXECUTABLE}" -C "${source}" config user.name "Version contract")
run("${GIT_EXECUTABLE}" -C "${source}" config user.email "version@example.invalid")
run("${GIT_EXECUTABLE}" -C "${source}" add .)
run("${GIT_EXECUTABLE}" -C "${source}" commit -qm "First synthetic commit")
run("${CMAKE_COMMAND}" -S "${source}" -B "${build}" -G Ninja)
run("${CMAKE_COMMAND}" --build "${build}" --parallel 1)
read_manifest(first)
check_json("${first}" sourceProvenance git)
check_json("${first}" dirty OFF)
check_json("${first}" commitCount 1)
string(JSON first_version GET "${first}" version)
check_binaries("${build}" "${first}")
# HEAD changes without touching a source or reconfiguring: the ordinary build must refresh.
run("${GIT_EXECUTABLE}" -C "${source}" commit --allow-empty -qm "Second synthetic commit")
run("${CMAKE_COMMAND}" --build "${build}" --parallel 1)
read_manifest(second)
check_json("${second}" commitCount 2)
string(JSON second_version GET "${second}" version)
if(first_version STREQUAL second_version)
  message(FATAL_ERROR "An incremental build kept the previous commit's version")
endif()
check_binaries("${build}" "${second}")
file(APPEND "${source}/main.cpp" "\n// Synthetic uncommitted edit.\n")
run("${CMAKE_COMMAND}" --build "${build}" --parallel 1)
read_manifest(dirty)
check_json("${dirty}" dirty ON)
string(JSON dirty_version GET "${dirty}" version)
if(NOT dirty_version MATCHES "[.]dirty$")
  message(FATAL_ERROR "Dirty build is not marked in its version")
endif()
# Packaging must retain compiled identity, even if HEAD advances without a build.
file(WRITE "${source}/runtime-asset.js" "${second_asset}")
run("${GIT_EXECUTABLE}" -C "${source}" add main.cpp runtime-asset.js)
run("${GIT_EXECUTABLE}" -C "${source}" commit -qm "Third synthetic commit")
execute_process(COMMAND "${CMAKE_CPACK_COMMAND}" --config "${build}/CPackConfig.cmake" -G TGZ -B "${TEST_ROOT}/packages"
  RESULT_VARIABLE packed OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT packed EQUAL 0)
  message(FATAL_ERROR "Packaging compiled snapshot failed: ${out}\n${err}")
endif()
string(JSON dirty_package_version GET "${dirty}" packageVersion)
file(GLOB packages "${TEST_ROOT}/packages/*${dirty_package_version}*.tar.gz")
list(LENGTH packages count)
if(NOT count EQUAL 1)
  message(FATAL_ERROR "Package name did not retain compiled version: ${packages}")
endif()
file(ARCHIVE_EXTRACT INPUT "${packages}" DESTINATION "${TEST_ROOT}/unpacked")
file(GLOB_RECURSE packaged_manifests "${TEST_ROOT}/unpacked/build-info.json")
list(LENGTH packaged_manifests manifest_count)
if(NOT manifest_count EQUAL 1)
  message(FATAL_ERROR "Package does not contain exactly one build manifest")
endif()
file(READ "${packaged_manifests}" packaged_manifest)
if(NOT packaged_manifest STREQUAL dirty)
  message(FATAL_ERROR "Installed manifest differs from the compiled snapshot")
endif()
get_filename_component(packaged_data_dir "${packaged_manifests}" DIRECTORY)
check_asset("${packaged_data_dir}/runtime-asset.js" "${first_asset}")
check_binaries("${packaged_data_dir}/../../bin" "${packaged_manifest}")
run("${CMAKE_COMMAND}" --install "${build}" --prefix "${TEST_ROOT}/old-installed")
check_asset("${TEST_ROOT}/old-installed/share/putgd/runtime-asset.js" "${first_asset}")
check_binaries("${TEST_ROOT}/old-installed/bin" "${dirty}")
find_program(dpkg_deb dpkg-deb)
if(dpkg_deb)
  run("${CMAKE_CPACK_COMMAND}" --config "${build}/CPackConfig.cmake" -G DEB -B "${TEST_ROOT}/debian")
  file(GLOB debian_package "${TEST_ROOT}/debian/*.deb")
  execute_process(COMMAND "${dpkg_deb}" --field "${debian_package}" Version
    RESULT_VARIABLE result OUTPUT_VARIABLE debian_version OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(NOT result EQUAL 0 OR NOT debian_version STREQUAL dirty_package_version)
    message(FATAL_ERROR "Debian metadata does not match compiled version")
  endif()
endif()
# Reconfiguration observes the new commit before binaries are rebuilt. A normal
# install must stop before writing a manifest that would misidentify old binaries.
run("${CMAKE_COMMAND}" -S "${source}" -B "${build}" -G Ninja)
execute_process(COMMAND "${CMAKE_COMMAND}" --install "${build}" --prefix "${TEST_ROOT}/stale-install"
  RESULT_VARIABLE stale OUTPUT_VARIABLE out ERROR_VARIABLE err)
file(WRITE "${TEST_ROOT}/stale-install.log" "exit=${stale}\n${out}\n${err}")
if(stale EQUAL 0 OR NOT "${out}${err}" MATCHES "does not match compiled build manifest"
    OR EXISTS "${TEST_ROOT}/stale-install/share/putgd/build-info.json")
  message(FATAL_ERROR "Direct installation did not reject stale binaries before writing: ${out}\n${err}")
endif()
# Updating only CLI makes a mixed build: reject instead of mislabeling its resident.
run("${CMAKE_COMMAND}" --build "${build}" --target putgd-cli --parallel 1)
execute_process(COMMAND "${CMAKE_CPACK_COMMAND}" --config "${build}/CPackConfig.cmake" -G TGZ -B "${TEST_ROOT}/mixed"
  RESULT_VARIABLE mixed OUTPUT_VARIABLE out ERROR_VARIABLE err)
file(WRITE "${TEST_ROOT}/mixed-package.log" "exit=${mixed}\n${out}\n${err}")
if(mixed EQUAL 0 OR NOT "${out}${err}" MATCHES "does not match compiled build manifest")
  message(FATAL_ERROR "Mixed binary versions were not rejected: ${out}\n${err}")
endif()
# Updating the resident too still leaves the UI helper at the old revision.
# Both ordinary install and CPack must reject that partial build before writing.
run("${CMAKE_COMMAND}" --build "${build}" --target putgd --parallel 1)
execute_process(COMMAND "${CMAKE_COMMAND}" --install "${build}" --prefix "${TEST_ROOT}/stale-ui-install"
  RESULT_VARIABLE stale_ui OUTPUT_VARIABLE out ERROR_VARIABLE err)
file(WRITE "${TEST_ROOT}/stale-ui-install.log" "exit=${stale_ui}\n${out}\n${err}")
if(stale_ui EQUAL 0 OR NOT "${out}${err}" MATCHES "putgd-ui does not match compiled build manifest"
    OR EXISTS "${TEST_ROOT}/stale-ui-install/share/putgd/build-info.json"
    OR EXISTS "${TEST_ROOT}/stale-ui-install/bin/putgd")
  message(FATAL_ERROR "Direct installation did not reject the stale UI helper before writing: ${out}\n${err}")
endif()
execute_process(COMMAND "${CMAKE_CPACK_COMMAND}" --config "${build}/CPackConfig.cmake" -G TGZ -B "${TEST_ROOT}/stale-ui-package"
  RESULT_VARIABLE stale_ui_package OUTPUT_VARIABLE out ERROR_VARIABLE err)
file(WRITE "${TEST_ROOT}/stale-ui-package.log" "exit=${stale_ui_package}\n${out}\n${err}")
if(stale_ui_package EQUAL 0 OR NOT "${out}${err}" MATCHES "putgd-ui does not match compiled build manifest")
  message(FATAL_ERROR "Packaging did not reject the stale UI helper: ${out}\n${err}")
endif()
# Updating all three original executables still leaves the KDE selector stale.
# Its exact build handshake would otherwise reject region capture after installation.
run("${CMAKE_COMMAND}" --build "${build}" --target putgd-ui --parallel 1)
execute_process(COMMAND "${CMAKE_COMMAND}" --install "${build}" --prefix "${TEST_ROOT}/stale-kde-install"
  RESULT_VARIABLE stale_kde OUTPUT_VARIABLE out ERROR_VARIABLE err)
file(WRITE "${TEST_ROOT}/stale-kde-install.log" "exit=${stale_kde}\n${out}\n${err}")
if(stale_kde EQUAL 0 OR NOT "${out}${err}" MATCHES "putgd-kde-region does not match compiled build manifest"
    OR EXISTS "${TEST_ROOT}/stale-kde-install/share/putgd/build-info.json"
    OR EXISTS "${TEST_ROOT}/stale-kde-install/bin/putgd"
    OR EXISTS "${TEST_ROOT}/stale-kde-install/bin/putgd-kde-region")
  message(FATAL_ERROR "Direct installation did not reject the stale KDE selector before writing: ${out}\n${err}")
endif()
execute_process(COMMAND "${CMAKE_CPACK_COMMAND}" --config "${build}/CPackConfig.cmake" -G TGZ -B "${TEST_ROOT}/stale-kde-package"
  RESULT_VARIABLE stale_kde_package OUTPUT_VARIABLE out ERROR_VARIABLE err)
file(WRITE "${TEST_ROOT}/stale-kde-package.log" "exit=${stale_kde_package}\n${out}\n${err}")
if(stale_kde_package EQUAL 0 OR NOT "${out}${err}" MATCHES "putgd-kde-region does not match compiled build manifest")
  message(FATAL_ERROR "Packaging did not reject the stale KDE selector: ${out}\n${err}")
endif()
run("${CMAKE_COMMAND}" --build "${build}" --parallel 1)
run("${CMAKE_COMMAND}" --install "${build}" --prefix "${TEST_ROOT}/installed")
file(READ "${TEST_ROOT}/installed/share/putgd/build-info.json" installed)
check_binaries("${TEST_ROOT}/installed/bin" "${installed}")
check_asset("${TEST_ROOT}/installed/share/putgd/runtime-asset.js" "${second_asset}")
# An asset-only edit must refresh the configured snapshot through an ordinary
# incremental build, without a manual CMake configure or a C++ source edit.
set(edited_asset "// Synthetic uncommitted runtime asset edit.\n")
file(WRITE "${source}/runtime-asset.js" "${edited_asset}")
run("${CMAKE_COMMAND}" --build "${build}" --parallel 1)
read_manifest(asset_rebuilt)
check_json("${asset_rebuilt}" dirty ON)
check_binaries("${build}" "${asset_rebuilt}")
run("${CMAKE_COMMAND}" --install "${build}" --prefix "${TEST_ROOT}/asset-rebuilt")
check_asset("${TEST_ROOT}/asset-rebuilt/share/putgd/runtime-asset.js" "${edited_asset}")
file(MAKE_DIRECTORY "${TEST_ROOT}/archive")
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${source}" archive HEAD OUTPUT_FILE "${TEST_ROOT}/source.tar" RESULT_VARIABLE archived)
if(NOT archived EQUAL 0)
  message(FATAL_ERROR "Cannot create synthetic source archive")
endif()
file(ARCHIVE_EXTRACT INPUT "${TEST_ROOT}/source.tar" DESTINATION "${TEST_ROOT}/archive")
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${source}" rev-parse HEAD OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE)
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${source}" rev-parse "HEAD^{tree}" OUTPUT_VARIABLE tree OUTPUT_STRIP_TRAILING_WHITESPACE)
run("${CMAKE_COMMAND}" -S "${TEST_ROOT}/archive" -B "${TEST_ROOT}/archive-build" -G Ninja
  "-DPUTGD_SOURCE_COMMIT=${commit}" "-DPUTGD_SOURCE_TREE=${tree}" -DPUTGD_SOURCE_COMMIT_COUNT=3)
run("${CMAKE_COMMAND}" --build "${TEST_ROOT}/archive-build" --parallel 1)
file(READ "${TEST_ROOT}/archive-build/build-identity/build-info.json" supplied)
check_json("${supplied}" sourceProvenance supplied)
check_json("${supplied}" gitCommit "${commit}")
check_json("${supplied}" gitTree "${tree}")
run("${CMAKE_COMMAND}" -S "${TEST_ROOT}/archive" -B "${TEST_ROOT}/unknown-build" -G Ninja)
file(READ "${TEST_ROOT}/unknown-build/build-identity/build-info.json" unknown)
check_json("${unknown}" sourceProvenance unknown)
check_json("${unknown}" version 0.1.1-dev.unknown)
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${TEST_ROOT}/archive" -B "${TEST_ROOT}/invalid-build" -G Ninja
  -DPUTGD_SOURCE_COMMIT=not-a-commit "-DPUTGD_SOURCE_TREE=${tree}" -DPUTGD_SOURCE_COMMIT_COUNT=3
  RESULT_VARIABLE invalid OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(invalid EQUAL 0 OR NOT "${out}${err}" MATCHES "Invalid supplied source provenance")
  message(FATAL_ERROR "Invalid archive provenance was accepted: ${out}\n${err}")
endif()
# Minimal builds have no KDE target and must not resolve or require its target-file expression.
set(minimal_build "${TEST_ROOT}/minimal-build")
run("${CMAKE_COMMAND}" -S "${source}" -B "${minimal_build}" -G Ninja -DPUTGD_VERSION_FIXTURE_KDE_HELPER=OFF)
run("${CMAKE_COMMAND}" --build "${minimal_build}" --parallel 1)
run("${CMAKE_COMMAND}" --install "${minimal_build}" --prefix "${TEST_ROOT}/minimal-installed")
file(READ "${TEST_ROOT}/minimal-installed/share/putgd/build-info.json" minimal_manifest)
check_binaries("${TEST_ROOT}/minimal-installed/bin" "${minimal_manifest}" OFF)
if(EXISTS "${TEST_ROOT}/minimal-installed/bin/putgd-kde-region")
  message(FATAL_ERROR "Minimal installation unexpectedly contains a KDE helper")
endif()
run("${CMAKE_CPACK_COMMAND}" --config "${minimal_build}/CPackConfig.cmake" -G TGZ -B "${TEST_ROOT}/minimal-package")
message(STATUS "Version contract passed: product executable identities, stale UI/KDE helper rejection, absent-KDE builds, commits, dirty state, package snapshots and source archives")
