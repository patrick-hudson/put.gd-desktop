{
  "desktop": "ubuntu-gnome-x11",
  "input_backend": {
    "guest": "qmp",
    "native": "vnc-or-host-input"
  },
  "catalog_tolerance": 0.025,
  "notification_server": "gnome-shell",
  "default_browser_kind": "firefox",
  "at_spi": {
    "available": true,
    "reason": ""
  },
  "session": "x11",
  "known_gaps": [
    "Catalogs are synthetic content; desktop drawn surfaces require human review"
  ],
  "window_titles": {
    "history": "^put\\.gd$",
    "settings": "^put\\.gd$",
    "main": "^put\\.gd$",
    "editor": "^Edit (image|& upload)",
    "review": "Review",
    "diagnostics": "Diagnostics",
    "about": "About",
    "destinations": "^put\\.gd$",
    "updates": "^put\\.gd$",
    "bar": "^put\\.gd recording controls$",
    "fileDialog": ".*",
    "putgdFileDialog": ".*",
    "region": ".*",
    "recsel": ".*"
  },
  "catalog_windows": {},
  "focus": {
    "backend": "ewmh",
    "raise_before_input": false
  },
  "notifications": {
    "accessible": {
      "application": "gnome-shell*"
    },
    "title_name_glob": "*{summary}*",
    "reason": "Two Ubuntu GNOME guest attempts did not observe the requested toast; saved frames show a pre-existing Software Updater banner (#670)",
    "actions_verified": false
  },
  "windows": {
    "editor.canvas": {
      "owner": "editor",
      "accessible": {
        "name": "Image being edited"
      }
    },
    "fileDialog": {
      "title": ".*",
      "accessible": {
        "role": "file chooser",
        "application": "putgd*"
      }
    },
    "putgdFileDialog": {
      "title": ".*",
      "accessible": {
        "role": "file chooser",
        "application": "putgd*"
      }
    },
    "region": {
      "title": ".*",
      "accessible": {
        "name": "Capture region",
        "application": "putgd*"
      }
    },
    "recsel": {
      "title": ".*",
      "accessible": {
        "name": "Recording region",
        "application": "putgd*"
      }
    },
    "historyContextMenu": {
      "owner": "history",
      "popup": true
    },
    "historyRowMenu": {
      "owner": "history",
      "popup": true
    },
    "maskOptionsMenu": {
      "owner": "review",
      "popup": true
    },
    "confirmAction": {
      "title": ".*",
      "accessible": {
        "role": "dialog",
        "application": "putgd*"
      }
    },
    "confirm": {
      "title": ".*",
      "accessible": {
        "role": "dialog",
        "application": "putgd*"
      }
    },
    "confirmDestinationDefault": {
      "title": ".*",
      "accessible": {
        "role": "dialog",
        "application": "putgd*"
      }
    },
    "confirmDestinationReload": {
      "title": ".*",
      "accessible": {
        "role": "dialog",
        "application": "putgd*"
      }
    },
    "confirmDestinationRemove": {
      "title": ".*",
      "accessible": {
        "role": "dialog",
        "application": "putgd*"
      }
    }
  },
  "evidence": {
    "note": "Live/sensitive frames: banner areas of this desktop's notification server (top and bottom positions) are always masked; in declared desktop frames non-owned windows other than browsers and the shell's own processes are masked, browser chrome is masked from live window geometry, and window-list panels only when a window title carries a link or registered value.",
    "notification_areas": [
      {
        "anchor": "top-center",
        "width": 560,
        "height": 0.45
      }
    ],
    "window_list_panels": [
      {
        "anchor": "top",
        "height": 40
      }
    ],
    "browser": {
      "title": "(Mozilla Firefox|Firefox|Chromium|Google Chrome|Web)$",
      "chrome_height": 170
    },
    "shell_processes": [
      "gnome-shell"
    ],
    "shell_areas": [
      {
        "anchor": "top",
        "height": 40
      },
      {
        "anchor": "left",
        "width": 72
      }
    ]
  }
}
