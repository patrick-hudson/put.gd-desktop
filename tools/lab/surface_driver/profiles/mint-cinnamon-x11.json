{
  "desktop": "mint-cinnamon-x11",
  "input_backend": {
    "guest": "qmp",
    "native": "vnc-or-host-input"
  },
  "catalog_tolerance": 0.025,
  "notification_server": "cinnamon",
  "default_browser_kind": "firefox",
  "at_spi": {
    "available": true,
    "reason": ""
  },
  "session": "x11",
  "known_gaps": [
    "Catalogs are synthetic content; desktop drawn surfaces require human review"
  ],
  "window_titles": {
    "history": "^put\\.gd$",
    "settings": "^put\\.gd$",
    "main": "^put\\.gd$",
    "editor": "^Edit (image|& upload)",
    "review": "Review",
    "diagnostics": "Diagnostics",
    "about": "About",
    "destinations": "^put\\.gd$",
    "updates": "^put\\.gd$",
    "bar": "^put\\.gd recording controls$",
    "fileDialog": ".*",
    "putgdFileDialog": ".*",
    "region": ".*",
    "recsel": ".*"
  },
  "catalog_windows": {},
  "focus": {
    "backend": "ewmh",
    "raise_before_input": false,
    "desktop_hit_test": "shell-at-spi"
  },
  "notifications": {
    "accessible": {
      "application": "cinnamon*"
    }
  },
  "windows": {
    "editor.canvas": {
      "owner": "editor",
      "accessible": {
        "name": "Image being edited"
      }
    },
    "fileDialog": {
      "title": ".*",
      "accessible": {
        "role": "file chooser",
        "application": "putgd*"
      }
    },
    "putgdFileDialog": {
      "title": ".*",
      "accessible": {
        "role": "file chooser",
        "application": "putgd*"
      }
    },
    "region": {
      "title": ".*",
      "accessible": {
        "name": "Capture region",
        "application": "putgd*"
      }
    },
    "recsel": {
      "title": ".*",
      "accessible": {
        "name": "Recording region",
        "application": "putgd*"
      }
    },
    "historyContextMenu": {
      "owner": "history",
      "popup": true
    },
    "historyRowMenu": {
      "owner": "history",
      "popup": true
    },
    "maskOptionsMenu": {
      "owner": "review",
      "popup": true
    },
    "confirmAction": {
      "title": ".*",
      "accessible": {
        "role": "dialog",
        "application": "putgd*"
      }
    },
    "confirm": {
      "title": ".*",
      "accessible": {
        "role": "dialog",
        "application": "putgd*"
      }
    },
    "confirmDestinationDefault": {
      "title": ".*",
      "accessible": {
        "role": "dialog",
        "application": "putgd*"
      }
    },
    "confirmDestinationReload": {
      "title": ".*",
      "accessible": {
        "role": "dialog",
        "application": "putgd*"
      }
    },
    "confirmDestinationRemove": {
      "title": ".*",
      "accessible": {
        "role": "dialog",
        "application": "putgd*"
      }
    }
  },
  "selector_accessible": {
    "query": {
      "owned": true
    },
    "via": "run observer focus event: NativeRegionAccessible is not one of Qt's application children, so a tree walk misses it (#701)"
  },
  "evidence": {
    "note": "Live/sensitive frames: banner areas of this desktop's notification server (top and bottom positions) are always masked; browser chrome is masked from live window geometry; window-list panels only when a window title carries a link or registered value.",
    "notification_areas": [
      {
        "anchor": "top-right",
        "width": 520,
        "height": 0.5
      },
      {
        "anchor": "bottom-right",
        "width": 520,
        "height": 0.5
      }
    ],
    "window_list_panels": [
      {
        "anchor": "bottom",
        "height": 48
      }
    ],
    "browser": {
      "title": "(Mozilla Firefox|Firefox|Chromium|Google Chrome|Web)$",
      "chrome_height": 170
    }
  }
}
