  "settings": {
    "prepare_script": "set -eu\nbusctl --user set-property org.a11y.Bus /org/a11y/bus org.a11y.Status IsEnabled b true\nbusctl --user set-property org.a11y.Bus /org/a11y/bus org.a11y.Status ScreenReaderEnabled b true\nsettings_output=$(xrandr --query | awk '/ connected primary / {print $1; exit}')\ntest -n \"$settings_output\" && xrandr --output \"$settings_output\" --mode 1920x1080\ntest -n \"$settings_window\" && xdotool windowsize \"$settings_window\" 1440 960 windowmove \"$settings_window\" 120 40\nxdotool windowactivate --sync \"$settings_window\" windowraise \"$settings_window\"",
    "foreground_script": "export settings_window\npython3 - <<'SETTINGS_INPUT'\nimport json, os, pathlib, subprocess\nwindow = os.environ['settings_window']\nassert window.isdecimal()\ndef command(*args):\n    return subprocess.check_output(['xdotool', *args], text=True).strip()\npid = int(command('getwindowpid', window))\nenvironment = pathlib.Path('/proc/' + str(pid) + '/environ').read_bytes().split(b'\\0')\nassert ('XDG_RUNTIME_DIR=' + os.environ['XDG_RUNTIME_DIR']).encode() in environment\nif command('getactivewindow') != window:\n    command('windowraise', window, 'windowactivate', '--sync', window)\npointer = dict(line.split('=', 1) for line in command('getmouselocation', '--shell').splitlines())\nprint(json.dumps({'window': window, 'pid': pid, 'active': command('getactivewindow'),\n                  'focus': command('getwindowfocus'), 'x': int(pointer['X']), 'y': int(pointer['Y'])}))\nSETTINGS_INPUT",
    "input_state_script": "export settings_window\npython3 - <<'SETTINGS_INPUT'\nimport json, os, pathlib, subprocess\nwindow = os.environ['settings_window']\nassert window.isdecimal()\ndef command(*args):\n    return subprocess.check_output(['xdotool', *args], text=True).strip()\npid = int(command('getwindowpid', window))\nenvironment = pathlib.Path('/proc/' + str(pid) + '/environ').read_bytes().split(b'\\0')\nassert ('XDG_RUNTIME_DIR=' + os.environ['XDG_RUNTIME_DIR']).encode() in environment\n\npointer = dict(line.split('=', 1) for line in command('getmouselocation', '--shell').splitlines())\nprint(json.dumps({'window': window, 'pid': pid, 'active': command('getactivewindow'),\n                  'focus': command('getwindowfocus'), 'x': int(pointer['X']), 'y': int(pointer['Y'])}))\nSETTINGS_INPUT",
