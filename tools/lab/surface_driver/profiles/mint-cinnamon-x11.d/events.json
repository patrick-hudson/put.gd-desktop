{
  "events": {
    "clipboardWrite": "xclip -selection clipboard",
    "panelTheme": {
      "read": [
        "env",
        "-u",
        "XDG_CONFIG_HOME",
        "gsettings",
        "get",
        "org.cinnamon.theme",
        "name"
      ],
      "write": [
        "env",
        "-u",
        "XDG_CONFIG_HOME",
        "gsettings",
        "set",
        "org.cinnamon.theme",
        "name"
      ],
      "light": "Mint-Y",
      "dark": "Mint-Y-Dark"
    }
  }
}
