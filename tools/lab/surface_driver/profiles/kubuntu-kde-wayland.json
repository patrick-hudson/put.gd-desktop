{
  "desktop": "kubuntu-kde-wayland",
  "input_backend": {
    "guest": "qmp",
    "native": "vnc-or-host-input"
  },
  "catalog_tolerance": 0.025,
  "notification_server": "plasmashell",
  "default_browser_kind": "firefox",
  "at_spi": {
    "available": true,
    "reason": ""
  },
  "session": "wayland",
  "known_gaps": [
    "Catalogs are synthetic content; desktop drawn surfaces require human review"
  ],
  "window_titles": {
    "history": "^put\\.gd$",
    "settings": "^put\\.gd$",
    "main": "^put\\.gd$",
    "editor": "^Edit (image|& upload)",
    "review": "Review",
    "diagnostics": "Diagnostics",
    "about": "About",
    "destinations": "^put\\.gd$",
    "updates": "^put\\.gd$",
    "bar": "^put\\.gd recording controls$",
    "fileDialog": ".*",
    "putgdFileDialog": ".*",
    "region": ".*",
    "recsel": ".*"
  },
  "catalog_windows": {},
  "focus": {
    "backend": "compositor-witness",
    "raise_before_input": false,
    "reason": "KWin stacking order, active window and clientGeometry from a read-only KWin script; no Wayland raise"
  },
  "notifications": {
    "accessible": {
      "application": "plasmashell*"
    }
  },
  "windows": {
    "editor.canvas": {
      "owner": "editor",
      "accessible": {
        "name": "Image being edited"
      }
    },
    "fileDialog": {
      "title": ".*",
      "accessible": {
        "role": "file chooser",
        "application": "putgd*"
      }
    },
    "putgdFileDialog": {
      "title": ".*",
      "accessible": {
        "role": "file chooser",
        "application": "putgd*"
      }
    },
    "region": {
      "title": ".*",
      "accessible": {
        "name": "Capture region",
        "application": "putgd*"
      }
    },
    "recsel": {
      "title": ".*",
      "accessible": {
        "name": "Recording region",
        "application": "putgd*"
      }
    },
    "historyContextMenu": {
      "owner": "history",
      "popup": true
    },
    "historyRowMenu": {
      "owner": "history",
      "popup": true
    },
    "maskOptionsMenu": {
      "owner": "review",
      "popup": true
    },
    "confirmAction": {
      "title": ".*",
      "accessible": {
        "role": "dialog",
        "application": "putgd*"
      }
    },
    "confirm": {
      "title": ".*",
      "accessible": {
        "role": "dialog",
        "application": "putgd*"
      }
    },
    "confirmDestinationDefault": {
      "title": ".*",
      "accessible": {
        "role": "dialog",
        "application": "putgd*"
      }
    },
    "confirmDestinationReload": {
      "title": ".*",
      "accessible": {
        "role": "dialog",
        "application": "putgd*"
      }
    },
    "confirmDestinationRemove": {
      "title": ".*",
      "accessible": {
        "role": "dialog",
        "application": "putgd*"
      }
    }
  },
  "compositor": {
    "kind": "kwin-script",
    "shell_application": "",
    "stage": "none: a one-shot read-only KWin script loaded over org.kde.KWin /Scripting per observation"
  },
  "evidence": {
    "note": "Live/sensitive frames: banner areas of this desktop's notification server (top and bottom positions) are always masked; in declared desktop frames non-owned windows other than browsers and the shell's own processes are masked, browser chrome is masked from live window geometry, and window-list panels only when a window title carries a link or registered value.",
    "notification_areas": [
      {
        "anchor": "bottom-right",
        "width": 520,
        "height": 0.6
      }
    ],
    "window_list_panels": [
      {
        "anchor": "bottom",
        "height": 52
      }
    ],
    "browser": {
      "title": "(Mozilla Firefox|Firefox|Chromium|Google Chrome|Web)$",
      "chrome_height": 170
    },
    "shell_processes": [
      "plasmashell",
      "kwin_wayland",
      "kwin_x11"
    ],
    "shell_areas": [
      {
        "anchor": "bottom",
        "height": 52
      }
    ]
  },
  "recording": {
    "consent": {
      "kind": "portal-dialog",
      "reason": "KWin's zkde_screencast native path needs no consent; the portal fallback shows xdg-desktop-portal-kde's screen chooser. Its dialog title and prompt are not yet observed on a lab guest, so only the backend process and accept button are pinned (#791, #822)",
      "backends": [
        "xdg-desktop-portal-kde"
      ],
      "shell_backends": [],
      "dialog": {
        "title": "*"
      },
      "accept": {
        "role": "push button",
        "name": "Share"
      },
      "backend_bus": "org.freedesktop.impl.portal.desktop.kde"
    }
  }
}
