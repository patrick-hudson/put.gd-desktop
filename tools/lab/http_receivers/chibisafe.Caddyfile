# Chibisafe's own reverse-proxy layout (its docker-compose), for one podman pod: the API
# on loopback, the web app on the pod's host name, uploads served from the shared volume.
:80 {
	route {
		file_server * {
			root /app/uploads
			pass_thru
		}
		@api path /api/*
		reverse_proxy @api http://127.0.0.1:8000 {
			header_up Host {http.reverse_proxy.upstream.hostport}
			header_up X-Real-IP {http.request.header.X-Real-IP}
		}
		@docs path /docs*
		reverse_proxy @docs http://127.0.0.1:8000 {
			header_up Host {http.reverse_proxy.upstream.hostport}
			header_up X-Real-IP {http.request.header.X-Real-IP}
		}
		reverse_proxy http://putgd-rx-chibisafe:8001 {
			header_up Host {http.reverse_proxy.upstream.hostport}
			header_up X-Real-IP {http.request.header.X-Real-IP}
		}
	}
}
