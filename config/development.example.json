{
  "schemaVersion": 1,
  "actions": {
    "region": {
      "destination": "upload",
      "profileId": "development-s3",
      "shortcut": "Ctrl+Shift+1"
    },
    "window": {
      "destination": "upload",
      "profileId": "development-s3",
      "shortcut": "Ctrl+Shift+2"
    },
    "desktop": {
      "destination": "upload",
      "profileId": "development-s3",
      "shortcut": "Ctrl+Shift+3"
    },
    "clipboard": {
      "destination": "upload",
      "profileId": "development-s3",
      "shortcut": ""
    }
  },
  "profiles": [
    {
      "id": "development-s3",
      "label": "put.gd development destination",
      "provider": "s3",
      "settings": {
        "bucket": "put.gd",
        "region": "us-east-2",
        "endpoint": "https://s3.us-east-2.amazonaws.com",
        "objectPrefix": "",
        "storageClass": "STANDARD",
        "aclMode": "public-read",
        "publicUrlBase": "https://put.gd",
        "addressing": "path",
        "connectTimeoutMs": 5000,
        "requestTimeoutMs": 60000,
        "lowSpeedBytesPerSecond": 1,
        "lowSpeedTimeSeconds": 30
      },
      "credentials": {
        "mode": "keychain",
        "reference": "putgd/development-s3"
      }
    }
  ],
  "archive": {
    "keepUploads": false,
    "root": "/home/your-user/Documents/put.gd",
    "folders": {
      "images": null,
      "videos": null,
      "text": null,
      "other": null
    }
  },
  "naming": {
    "mode": "generated",
    "collisionPolicy": "rename"
  },
  "limits": {
    "maxFiles": 100,
    "pendingOperations": 8,
    "concurrentUploads": 1,
    "maxFileBytes": 2147483648,
    "maxBatchBytes": 2147483648,
    "pendingArtifactBytes": 2147483648,
    "clipboardTextBytes": 16777216,
    "imagePixels": 100000000,
    "imageBytes": 536870912
  },
  "retention": {
    "failedArtifactDays": 7,
    "recentActivityLimit": 100,
    "previewCacheBytes": 268435456,
    "historyRetentionDays": null
  },
  "preferences": {
    "notifications": true,
    "launchAtLogin": false
  }
}
