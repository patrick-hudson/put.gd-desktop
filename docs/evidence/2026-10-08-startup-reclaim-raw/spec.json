    "exclusive_resources": [
      "physical-cinnamon-session"
    ]
  },
  "dependencies": {
    "approved": []
  },
  "constraints": [
    "Standard CMake/Ninja, dynamically linked distroQt; no new dependencies without approval.",
    "Preserve capture, clipboard ownership, S3 safety, configuration, history, drafts, custom visuals, accessibility and native input methods.",
    "Freeze benchmark while comparing experiments. Attribute startup cost before selecting changes.",
    "Only private synthetic local configuration, no host pixels, user clipboard content, credentials or cloud objects in memory benchmarks.",
    "Use serial physical measurements and separately record post-use costs; VNC stays active for lab acceptance.",
    "Keep original failed/successful experiment evidence; regression tests and graphical checks before integration.",
    "Request startup reclamation only after successful journal initialization through the existing two-second single-shot idle gate. No repeated idle timer, global allocator configuration or UI/cache teardown.",
    "Keep both physical memory observer scripts and the40MiB/100MiB/0.5% CPU targets unchanged. A candidate must save more than1MiB RSS to keep; this conservative absolute comparison is declared before experiments.",
    "Verify startup once-only behavior, active worker/upload/selector blocking, cancellation cleanup and shutdown. Preserve native GTK fonts/dialogs and first-action behavior.",
    "Use the committed current product as the reference. Preserve every failed/accepted run, exact sources and binaries. No paid infrastructure or new packages. Normal host model usage has no separate dollar cap; execution is bounded by one hour/two variants."
  ],
  "stopping": {
    "max_iterations": 2,
    "max_hours": 1,
    "plateau_iterations": 2,
    "target_reached": true
  },
