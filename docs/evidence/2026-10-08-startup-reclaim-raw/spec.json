{
  "name": "resident-startup-reclaim",
  "description": "Measure one startup request through the existing idle-gated heap reclamation path, preserving native Cinnamon integration and all application behavior.",
  "metric": {
    "primary": {
      "type": "hard",
      "name": "peakSampledRssBytes",
      "direction": "minimize",
      "target": 41943040
    },
    "degenerate_gates": [
      {
        "name": "budgetPassed",
        "check": "== 1",
        "description": "Preserve unchanged five-minute idle CPU and100MiB limits."
      }
    ],
    "diagnostics": [
      {
        "name": "idleCpuPercentOneCore"
      },
      {
        "name": "finalRssBytes"
      }
    ]
  },
  "measurement": {
    "command": "python3 tests/performance/observe_idle.py --app build/release/putgd --cli build/release/putgd-cli --output /tmp/putgd-startup-reclaim-unique --seconds 300",
    "timeout_seconds": 360,
    "working_directory": ".",
    "output_format": "json",
    "stability": {
      "mode": "stable",
      "noise_threshold": 1048576,
      "comparison": {
        "method": "absolute"
      }
    }
  },
