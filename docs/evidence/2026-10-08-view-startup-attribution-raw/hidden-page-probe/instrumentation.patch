+++ b/src/ui/StartupPolish.h
@@ -0,0 +1,61 @@
+#pragma once
+// Temporary diagnostic overlay. No widget names/text or configuration inspected.
+#include "StartupTrace.h"
+#include <QApplication>
+#include <QEvent>
+#include <QWidget>
+#include <array>
+namespace putgd {
+inline constexpr const char* startupPageProperty="_putgdStartupPageProbe";
+inline constexpr const char* startupSettingsProperty="_putgdStartupSettingsProbe";
+inline constexpr std::array<const char*,5> startupPageTokens{"shell","capture","destinations","shortcuts","preferences"};
+struct StartupPolishCounters {
+ bool active=false;
+ std::array<long long,5> nanoseconds{};
+ std::array<unsigned long long,5> count{};
+ struct Frame {long long nested=0;Frame* parent=nullptr;};
+ Frame* frame=nullptr;
+};
+inline StartupPolishCounters& startupPolishCounters(){static StartupPolishCounters counters;return counters;}
+inline long long startupPolishNow(){return std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();}
+inline void startupPolishBegin(QWidget* root){
+ root->setProperty(startupSettingsProperty,true);
+ auto& counters=startupPolishCounters();counters.nanoseconds={};counters.count={};counters.active=true;
+}
+inline void startupPolishSnapshot(const char* phase){
+ const auto& counters=startupPolishCounters();const auto now=startupPolishNow();
+ for(int i=0;i<5;++i)std::fprintf(stderr,"startup-polish-v1 %ld %lld %s %s %lld %llu\n",static_cast<long>(::getpid()),now,phase,startupPageTokens[i],counters.nanoseconds[i],counters.count[i]);
+ std::fflush(stderr);
+}
+inline void startupPolishEnd(){startupPolishCounters().active=false;}
+inline int startupPolishBucket(QObject* receiver){
+ if(!qobject_cast<QWidget*>(receiver))return -1;
+ int bucket=0;
+ bool assigned=false;
+ for(auto* object=receiver;object;object=object->parent()){
+  const auto property=object->property(startupPageProperty);
+  if(!assigned&&property.isValid()){const int candidate=property.toInt();if(candidate>=1&&candidate<=4){bucket=candidate;assigned=true;}}
+  if(object->property(startupSettingsProperty).toBool())return bucket;
+ }
+ return -1;
+}
+class StartupProbeApplication final:public QApplication {
+public:
+ using QApplication::QApplication;
+ bool notify(QObject* receiver,QEvent* event)override {
+  auto& counters=startupPolishCounters();
+  if(!counters.active||event->type()!=QEvent::Polish)return QApplication::notify(receiver,event);
+  const int bucket=startupPolishBucket(receiver);
+  if(bucket<0)return QApplication::notify(receiver,event);
+  StartupPolishCounters::Frame frame{0,counters.frame};counters.frame=&frame;
+  const auto start=startupPolishNow();
+  // Original Qt dispatch stays synchronous and is invoked exactly once.
+  const bool delivered=QApplication::notify(receiver,event);
+  const auto elapsed=startupPolishNow()-start;
+  counters.frame=frame.parent;
+  if(frame.parent)frame.parent->nested+=elapsed;
+  counters.nanoseconds[bucket]+=elapsed-frame.nested;++counters.count[bucket];
+  return delivered;
+ }
+};
+}
