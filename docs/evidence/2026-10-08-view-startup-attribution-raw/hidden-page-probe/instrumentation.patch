@@ -0,0 +1,30 @@
+#pragma once
+// Diagnostic overlay only: fixed labels and monotonic clocks, no private data.
+#include <QByteArray>
+#include <chrono>
+#include <cstdio>
+#include <cstring>
+#include <unistd.h>
+namespace putgd {
+inline bool knownStartupStage(const QByteArray& stage){
+ for(const char* token:{"main-entry","qapplication-pre","qapplication-post","visual-style-post","bootstrap-accepted","snapshot-request","snapshot-reply","snapshot-accepted","ready-pre","ready-post","settings-constructor-enter","settings-constructor-exit","settings-activate-enter","settings-show-pre","settings-show-post","settings-shown-sent","resident-launch-pre","resident-process-started","settings-page-capture-pre","settings-page-capture-post","settings-page-destinations-pre","settings-page-destinations-post","settings-page-shortcuts-pre","settings-page-shortcuts-post","settings-page-preferences-pre","settings-page-preferences-post","settings-wiring-pre","settings-wiring-post","settings-refresh-pre","settings-refresh-post"})if(stage==token)return true;
+ return false;
+}
+inline void startupTrace(const char* stage){
+ const auto ns=std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+ std::fprintf(stderr,"startup-stage-v1 %ld %lld %s\n",static_cast<long>(::getpid()),static_cast<long long>(ns),stage);std::fflush(stderr);
+}
+inline bool validStartupTrace(const QByteArray& line){
+ if(line.size()>256)return false;
+ const auto polish=line.split(' ');
+ if(polish.size()==7&&polish[0]=="startup-polish-v1"){
+  if(polish[3]!="ctor-enter"&&polish[3]!="ctor-exit"&&polish[3]!="show-pre"&&polish[3]!="show-post"&&polish[3]!="shown-sent")return false;
+  if(polish[4]!="shell"&&polish[4]!="capture"&&polish[4]!="destinations"&&polish[4]!="shortcuts"&&polish[4]!="preferences")return false;
+  for(int i:{1,2,5,6}){if(polish[i].isEmpty()||polish[i].size()>20)return false;for(auto c:polish[i])if(c<'0'||c>'9')return false;}
+  return true;
+ }
+ const auto parts=line.split(' ');if(parts.size()!=4||parts[0]!="startup-stage-v1"||!knownStartupStage(parts[3]))return false;
+ for(int i:{1,2}){if(parts[i].isEmpty()||parts[i].size()>20)return false;for(auto c:parts[i])if(c<'0'||c>'9')return false;}
+ return true;
+}
+}
