+QString addedConnection(const QStringList& before) {
+ QString result;
+ for(const auto& name:QSqlDatabase::connectionNames())if(!before.contains(name)) {
+  if(!result.isEmpty())return {};
+  result=name;
+ }
+ return result;
+}
+Operation syntheticOperation(const QString& id) {
+ Operation operation;operation.id=id;operation.state="accepted";
+ operation.created="2026-10-09T00:00:00.000Z";
+ operation.settings=Settings::fromValidated(Settings::defaults());
+ return operation;
+}
+// Run only in an owned child of this test. Cache spill creates an actual hot
+// rollback journal; killing the process tests recovery, not power-loss durability.
+int crashJournalWriter(const QString& path) {
+ const auto before=QSqlDatabase::connectionNames();HistoryStore store(path);
+ if(store.error())return 11;
+ const auto name=addedConnection(before);if(name.isEmpty())return 12;
+ auto db=QSqlDatabase::database(name,false);QSqlQuery query(db);
+ if(!query.exec("PRAGMA cache_size=8")||!db.transaction())return 13;
+ if(!query.exec("UPDATE operations SET data=json_set(data,'$.state','acquiring') WHERE id='crash-operation'")||
+    !query.exec("INSERT INTO crash_fixture(payload) VALUES(zeroblob(3145728))"))return 14;
+ query.finish();
+ QFile journal(path+"-journal");
+ if(!journal.open(QIODevice::ReadOnly)||journal.size()<=512||
+    journal.read(8)!=QByteArray::fromHex("d9d505f920a163d7"))return 15;
+ journal.close();
+ std::fputs("transaction-open\n",stdout);std::fflush(stdout);
+ std::getchar(); // Parent owns the pipe and kills us before normal rollback.
+ return 16;
+}
