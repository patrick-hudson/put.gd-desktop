+  std::barrier gate(3);Error errors[2];
+  auto work=[&](int index) {
+   gate.arrive_and_wait();HistoryStore store(path);errors[index]=store.error();if(errors[index])return;
+   for(int n=0;n<3;++n) {
+    auto operation=syntheticOperation(QString("worker-%1-%2").arg(index).arg(n));
+    if((errors[index]=store.saveOperation(operation)))return;
+    operation.state="acquiring";if((errors[index]=store.saveOperation(operation)))return;
+   }
+  };
+  std::unique_ptr<QThread> first(QThread::create([&]{work(0);})),second(QThread::create([&]{work(1);}));
+  first->start();second->start();gate.arrive_and_wait();
+  // Both workers finish before any assertion can destroy their captured state.
+  first->wait();second->wait();QVERIFY(!errors[0]);QVERIFY(!errors[1]);
+  HistoryStore observer(path);QVERIFY(!observer.error());Error error;
+  for(int index=0;index<2;++index)for(int n=0;n<3;++n) {
+   QCOMPARE(observer.operation(QString("worker-%1-%2").arg(index).arg(n),&error).state,QString("acquiring"));QVERIFY(!error);
