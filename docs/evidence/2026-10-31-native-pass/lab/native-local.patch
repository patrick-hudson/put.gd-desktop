diff --git a/tools/lab/surface_driver/native_local.py b/tools/lab/surface_driver/native_local.py
new file mode 100644
index 000000000..418bbd3ab
--- /dev/null
+++ b/tools/lab/surface_driver/native_local.py
@@ -0,0 +1,10 @@
+"""Admission for local synthetic outcomes on a leased physical desktop."""
+
+
+def admitted(ctx):
+    target = ctx.target
+    if not (ctx.destination == 'local' and ctx.placement == 'native'
+            and target.physical and target._lock and target.clipboard_report.get('ready')):
+        return False
+    target.heartbeat(force=True)
+    return True
