# The product executables and their install rules, apart from the helpers with their own file.
# The release signer's minisign keys (#293): an AppImage install checks the
# release's SHA256SUMS.minisig with its channel's key. Only putgd-cli links
# this and libcrypto (Ed25519, BLAKE2b); the resident never maps them.
foreach(putgd_channel nightly stable)
  file(STRINGS "${CMAKE_CURRENT_SOURCE_DIR}/packaging/linux/repo/keys/putgd-${putgd_channel}.minisign.pub" putgd_minisign_line REGEX "^RW[A-Za-z0-9+/=]+$")
  list(LENGTH putgd_minisign_line putgd_minisign_lines)
  if(NOT putgd_minisign_lines EQUAL 1)
    message(FATAL_ERROR "packaging/linux/repo/keys/putgd-${putgd_channel}.minisign.pub must hold one minisign public key")
  endif()
  string(TOUPPER "${putgd_channel}" putgd_channel_upper)
  set(PUTGD_MINISIGN_${putgd_channel_upper}_KEY "${putgd_minisign_line}")
endforeach()
add_library(putgd_minisign STATIC src/cli/Minisign.cpp)
target_include_directories(putgd_minisign PUBLIC src)
target_link_libraries(putgd_minisign PUBLIC Qt6::Core putgd_build_options)
target_compile_definitions(putgd_minisign PRIVATE "PUTGD_MINISIGN_NIGHTLY_KEY=\"${PUTGD_MINISIGN_NIGHTLY_KEY}\"" "PUTGD_MINISIGN_STABLE_KEY=\"${PUTGD_MINISIGN_STABLE_KEY}\"")
if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
  find_package(OpenSSL 1.1.1 REQUIRED COMPONENTS Crypto)
endif()
if(OpenSSL_FOUND)
  target_compile_definitions(putgd_minisign PRIVATE PUTGD_MINISIGN_OPENSSL=1)
  target_link_libraries(putgd_minisign PRIVATE OpenSSL::Crypto)
endif()
add_executable(putgd-cli src/cli/main.cpp src/cli/UpdateCheck.cpp src/cli/UpdateInstall.cpp)
target_link_libraries(putgd-cli PRIVATE putgd_app putgd_minisign Qt6::Network)
install(TARGETS putgd-cli RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR})
# The file manager's `putgd --upload` client (#1105). DEB/RPM builds resolve
# network URIs through the host's GIO in-process (GVfs FUSE paths).
find_package(PkgConfig REQUIRED)
pkg_check_modules(PUTGD_GIO REQUIRED IMPORTED_TARGET gio-2.0)
add_library(putgd_upload_client STATIC src/app/UploadClient.cpp)
# It talks to the resident over LocalIpc's raw socket, not QtNetwork: the
# resident maps no libQt6Network at idle (acceptance matrix gate C, #1149).
target_link_libraries(putgd_upload_client PUBLIC putgd_app putgd_session_protocol Qt6::DBus PRIVATE PkgConfig::PUTGD_GIO)
