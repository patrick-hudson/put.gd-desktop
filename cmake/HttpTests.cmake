# Custom HTTP uploader tests (#1361): the .sxcu and placeholder table, and the
# production provider and worker against the scripted loopback receiver.
if(BUILD_TESTING)
  add_executable(test_http_uploader_rules tests/unit/test_http_uploader.cpp)
  target_link_libraries(test_http_uploader_rules PRIVATE putgd_http_rules putgd_core Qt6::Test)
  add_test(NAME http_uploader_rules COMMAND test_http_uploader_rules)
  add_executable(test_http_uploader tests/integration/test_http_uploader.cpp)
  target_include_directories(test_http_uploader PRIVATE tests)
  target_link_libraries(test_http_uploader PRIVATE putgd_http putgd_app Qt6::Test Qt6::Network)
  target_compile_definitions(test_http_uploader PRIVATE HTTP_FIXTURE_PATH="${CMAKE_CURRENT_SOURCE_DIR}/tests/fixtures/http_uploader_server.py")
  add_dependencies(test_http_uploader putgd-http-worker)
  add_test(NAME http_uploader_integration COMMAND test_http_uploader)
  set_tests_properties(http_uploader_integration PROPERTIES TIMEOUT 240)
  # The UI catalog and the Settings GUI tests show the custom uploader form.
  if(TARGET putgd-ui-catalog)
    target_link_libraries(putgd-ui-catalog PRIVATE putgd_http)
  endif()
  foreach(area IN LISTS PUTGD_SETTINGS_GUI_AREAS)
    target_link_libraries(test_gui_settings_${area} PRIVATE putgd_http)
  endforeach()
endif()
