# Shared by ordinary cmake --install and CPack. Inspect the compiled snapshot,
# never the current Git checkout, before installing any files.
set(manifest_path "@PUTGD_BUILD_IDENTITY_DIR@/build-info.json")
if(NOT EXISTS "${manifest_path}")
  message(FATAL_ERROR "Build all product executables before installation or packaging")
endif()
file(READ "${manifest_path}" manifest)
string(JSON compiled_version GET "${manifest}" version)
string(JSON package_version GET "${manifest}" packageVersion)
set(programs putgd putgd-cli putgd-ui)
if(NOT "@PUTGD_PACKAGE_KDE_REGION@" STREQUAL "")
  list(APPEND programs putgd-kde-region)
endif()
if(NOT "@PUTGD_PACKAGE_CAPTURE@" STREQUAL "")
  list(APPEND programs putgd-capture)
endif()
string(STRIP "${manifest}" expected_manifest)
foreach(program IN LISTS programs)
  if(program STREQUAL "putgd")
    set(binary "@PUTGD_PACKAGE_APP@")
  elseif(program STREQUAL "putgd-cli")
    set(binary "@PUTGD_PACKAGE_CLI@")
  elseif(program STREQUAL "putgd-ui")
    set(binary "@PUTGD_PACKAGE_UI@")
  elseif(program STREQUAL "putgd-kde-region")
    set(binary "@PUTGD_PACKAGE_KDE_REGION@")
  else()
    set(binary "@PUTGD_PACKAGE_CAPTURE@")
  endif()
  execute_process(COMMAND "${binary}" --version RESULT_VARIABLE result
    OUTPUT_VARIABLE actual ERROR_VARIABLE error OUTPUT_STRIP_TRAILING_WHITESPACE TIMEOUT 15)
  if(NOT result EQUAL 0 OR NOT actual STREQUAL "${program} ${compiled_version}")
    message(FATAL_ERROR "${program} does not match compiled build manifest; build all product executables before installation or packaging (${error})")
  endif()
  execute_process(COMMAND "${binary}" --version-json RESULT_VARIABLE result
    OUTPUT_VARIABLE actual_manifest ERROR_VARIABLE error TIMEOUT 15)
  string(STRIP "${actual_manifest}" actual_manifest)
  if(NOT result EQUAL 0 OR NOT actual_manifest STREQUAL expected_manifest)
    message(FATAL_ERROR "${program} does not match compiled build manifest; build all product executables before installation or packaging (${error})")
  endif()
endforeach()
