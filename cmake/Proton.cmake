add_library(putgd_proton STATIC src/storage/proton/ProtonProvider.cpp)
target_link_libraries(putgd_proton PUBLIC putgd_core PRIVATE Qt6::Core)
set(PUTGD_PROTON_RUNTIME "${PROJECT_SOURCE_DIR}/build/dependencies/proton-runtime/putgd-proton-runtime" CACHE FILEPATH "Pinned bundled Proton SDK runtime")
option(PUTGD_BUNDLE_PROTON "Bundle the separately provisioned Proton runtime" OFF)
set(proton_hash "")
if(PUTGD_BUNDLE_PROTON)
  if(NOT EXISTS "${PUTGD_PROTON_RUNTIME}" OR NOT EXISTS "${PROJECT_SOURCE_DIR}/build/dependencies/proton-runtime/manifest.json")
    message(FATAL_ERROR "Provision the bundled Proton runtime with tools/proton/provision_runtime.py before enabling PUTGD_BUNDLE_PROTON")
  endif()
  file(READ "${PROJECT_SOURCE_DIR}/build/dependencies/proton-runtime/manifest.json" proton_manifest)
  string(JSON proton_manifest_hash GET "${proton_manifest}" sha256)
  string(JSON proton_protocol GET "${proton_manifest}" protocolVersion)
  file(SHA256 "${PUTGD_PROTON_RUNTIME}" proton_actual_hash)
  if(NOT proton_actual_hash STREQUAL proton_manifest_hash OR NOT proton_protocol EQUAL 1)
    message(FATAL_ERROR "Proton runtime manifest does not match its artifact/protocol; reprovision tools/proton/provision_runtime.py")
  endif()
  # A valid old executable is still stale after changing the helper or lock.
  # Verify known source members only; manifest paths cannot escape the source tree.
  set(proton_sources account.ts crypto-cache.ts protocol.ts provision_runtime.py runtime.ts stdout.ts progress.ts)
  string(JSON proton_source_count LENGTH "${proton_manifest}" helperSourceSha256)
  list(LENGTH proton_sources proton_expected_count)
  if(NOT proton_source_count EQUAL proton_expected_count)
    message(FATAL_ERROR "Proton source manifest is incomplete; reprovision tools/proton/provision_runtime.py")
  endif()
  foreach(proton_source IN LISTS proton_sources)
    string(JSON proton_source_hash ERROR_VARIABLE proton_source_error GET "${proton_manifest}" helperSourceSha256 "${proton_source}")
    file(SHA256 "${PROJECT_SOURCE_DIR}/tools/proton/${proton_source}" proton_current_source_hash)
    if(proton_source_error OR NOT proton_source_hash STREQUAL proton_current_source_hash)
      message(FATAL_ERROR "Proton helper source ${proton_source} changed; reprovision tools/proton/provision_runtime.py")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/tools/proton/${proton_source}")
  endforeach()
  file(READ "${PROJECT_SOURCE_DIR}/tools/proton/runtime-lock.json" proton_lock)
  foreach(proton_version sourceReference bunVersion)
    string(JSON proton_locked_version GET "${proton_lock}" "${proton_version}")
    string(JSON proton_built_version GET "${proton_manifest}" "${proton_version}")
    if(NOT proton_locked_version STREQUAL proton_built_version)
      message(FATAL_ERROR "Proton runtime ${proton_version} changed; reprovision tools/proton/provision_runtime.py")
    endif()
  endforeach()
  string(JSON proton_sdk GET "${proton_lock}" sdkVersion)
  string(JSON proton_built_sdk GET "${proton_manifest}" sdkVersion)
  string(JSON proton_app GET "${proton_lock}" runtimeVersion)
  string(JSON proton_built_app GET "${proton_manifest}" appVersion)
  if(NOT proton_built_sdk STREQUAL "js@${proton_sdk}" OR NOT proton_built_app STREQUAL "external-drive-put_gd@${proton_app}")
    message(FATAL_ERROR "Proton SDK/runtime versions changed; reprovision tools/proton/provision_runtime.py")
  endif()
  foreach(proton_pair "package-lock.json|dependencyLockSha256" "notices/THIRD-PARTY-NOTICES.txt|dependencyNoticesSha256")
    string(REPLACE "|" ";" proton_pair "${proton_pair}")
    list(GET proton_pair 0 proton_input)
    list(GET proton_pair 1 proton_manifest_key)
    file(SHA256 "${PROJECT_SOURCE_DIR}/tools/proton/${proton_input}" proton_current_input_hash)
    string(JSON proton_built_input_hash GET "${proton_manifest}" "${proton_manifest_key}")
    if(NOT proton_current_input_hash STREQUAL proton_built_input_hash)
      message(FATAL_ERROR "Proton ${proton_input} changed; reprovision tools/proton/provision_runtime.py")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/tools/proton/${proton_input}")
  endforeach()
  file(SHA256 "${PROJECT_SOURCE_DIR}/build/dependencies/proton-runtime/THIRD-PARTY-NOTICES.txt" proton_artifact_notices_hash)
  string(JSON proton_built_notices_hash GET "${proton_manifest}" dependencyNoticesSha256)
  if(NOT proton_artifact_notices_hash STREQUAL proton_built_notices_hash)
    message(FATAL_ERROR "Proton bundled notices do not match the manifest; reprovision tools/proton/provision_runtime.py")
  endif()
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/tools/proton/runtime-lock.json" "${PROJECT_SOURCE_DIR}/build/dependencies/proton-runtime/manifest.json" "${PROJECT_SOURCE_DIR}/build/dependencies/proton-runtime/THIRD-PARTY-NOTICES.txt")
  file(SHA512 "${PUTGD_PROTON_RUNTIME}" proton_hash)
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${PUTGD_PROTON_RUNTIME}")
  file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/proton")
  configure_file("${PUTGD_PROTON_RUNTIME}" "${CMAKE_CURRENT_BINARY_DIR}/proton/putgd-proton-runtime" COPYONLY)
  file(CHMOD "${CMAKE_CURRENT_BINARY_DIR}/proton/putgd-proton-runtime" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
  install(FILES "${PROJECT_SOURCE_DIR}/build/dependencies/proton-runtime/manifest.json" "${PROJECT_SOURCE_DIR}/build/dependencies/proton-runtime/THIRD-PARTY-NOTICES.txt" DESTINATION "${CMAKE_INSTALL_LIBEXECDIR}/putgd/proton")
  install(PROGRAMS "${CMAKE_CURRENT_BINARY_DIR}/proton/putgd-proton-runtime" DESTINATION "${CMAKE_INSTALL_LIBEXECDIR}/putgd/proton")
  install(FILES "${PROJECT_SOURCE_DIR}/build/dependencies/proton-runtime/manifest.json" DESTINATION "${CMAKE_INSTALL_DATADIR}/putgd" RENAME proton-runtime-manifest.json)
  install(DIRECTORY "${PROJECT_SOURCE_DIR}/tools/proton/notices/" DESTINATION "${CMAKE_INSTALL_DATADIR}/doc/putgd/proton")
endif()
file(RELATIVE_PATH proton_install_relative "${CMAKE_INSTALL_PREFIX}/${CMAKE_INSTALL_BINDIR}" "${CMAKE_INSTALL_PREFIX}/${CMAKE_INSTALL_LIBEXECDIR}/putgd/proton/putgd-proton-runtime")
target_compile_definitions(putgd_proton PRIVATE
  PUTGD_PROTON_BUILD_APP_DIR="${CMAKE_CURRENT_BINARY_DIR}"
  PUTGD_PROTON_BUILD_RUNTIME="${CMAKE_CURRENT_BINARY_DIR}/proton/putgd-proton-runtime"
  PUTGD_PROTON_INSTALL_RELATIVE="${proton_install_relative}"
  PUTGD_PROTON_RUNTIME_SHA512="${proton_hash}")
target_link_libraries(putgd PRIVATE putgd_proton)
target_link_libraries(putgd_ui PRIVATE putgd_proton)
if(BUILD_TESTING)
  add_executable(proton_latency_probe EXCLUDE_FROM_ALL tests/performance/proton_latency.cpp)
  target_link_libraries(proton_latency_probe PRIVATE putgd_proton)
  add_executable(test_proton tests/integration/test_proton.cpp)
  target_include_directories(test_proton PRIVATE tests)
  target_compile_definitions(test_proton PRIVATE PUTGD_TEST_PROTON_BUNDLED=$<BOOL:${PUTGD_BUNDLE_PROTON}>)
  target_link_libraries(test_proton PRIVATE putgd_proton putgd_app Qt6::Test)
  add_test(NAME proton_contract COMMAND test_proton)
  set_tests_properties(proton_contract PROPERTIES TIMEOUT 30)
  if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    # Compile the same adapter against an authenticated-hash synthetic peer;
    # the shipping target keeps only its pinned, bundled runtime path/hash.
    set(proton_test_peer "${CMAKE_CURRENT_BINARY_DIR}/proton-fixture/helper")
    configure_file("${PROJECT_SOURCE_DIR}/tests/fixtures/proton_transport.py" "${proton_test_peer}" COPYONLY)
    file(CHMOD "${proton_test_peer}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
    file(SHA512 "${proton_test_peer}" proton_test_hash)
    add_executable(test_proton_transport tests/integration/test_proton_transport.cpp src/storage/proton/ProtonProvider.cpp)
    target_link_libraries(test_proton_transport PRIVATE putgd_core Qt6::Test)
    target_compile_definitions(test_proton_transport PRIVATE
      PUTGD_PROTON_BUILD_APP_DIR="${CMAKE_CURRENT_BINARY_DIR}"
      PUTGD_PROTON_BUILD_RUNTIME="${proton_test_peer}"
      PUTGD_PROTON_INSTALL_RELATIVE="proton-fixture/helper"
      PUTGD_PROTON_RUNTIME_SHA512="${proton_test_hash}")
    add_test(NAME proton_transport COMMAND test_proton_transport)
    set_tests_properties(proton_transport PROPERTIES TIMEOUT 20)
  endif()
endif()
