include("@PUTGD_BUILD_IDENTITY_DIR@/check-build-identity.cmake")
set(CPACK_PACKAGE_VERSION "${package_version}")
set(CPACK_DEBIAN_PACKAGE_VERSION "${package_version}")
# Modern RPM and Debian both order tilde prereleases below their final version.
set(CPACK_RPM_PACKAGE_VERSION "${package_version}")
set(CPACK_RPM_PACKAGE_RELEASE "1")
set(CPACK_PACKAGE_FILE_NAME "${CPACK_PACKAGE_NAME}-${package_version}-${CPACK_SYSTEM_NAME}")
