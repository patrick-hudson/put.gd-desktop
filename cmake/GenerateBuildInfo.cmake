cmake_minimum_required(VERSION 3.24)
# Calendar versions (#373): YY.MDD.N is the UTC committer date of the source
# commit (month times 100 plus day) and its full-history commit count. Both come
# from the commit, never the clock, so rebuilding a tag gives the same version.
set(commit "")
set(tree "")
set(count "null")
set(time "")
set(dirty "null")
set(provenance unknown)
set(base "0.0.0")
set(version "0.0.0-dev.unknown")
set(package_version "0.0.0~dev.unknown")
if(EXISTS "${SOURCE_DIR}/.git")
  if(NOT "${SUPPLIED_COMMIT}${SUPPLIED_TREE}${SUPPLIED_COUNT}${SUPPLIED_TIME}" STREQUAL "")
    message(FATAL_ERROR "Archive source provenance cannot override a Git checkout")
  endif()
  find_program(git git REQUIRED)
  foreach(field commit tree count time status)
    if(field STREQUAL "commit")
      set(args rev-parse HEAD)
    elseif(field STREQUAL "tree")
      set(args rev-parse "HEAD^{tree}")
    elseif(field STREQUAL "count")
      set(args rev-list --count HEAD)
    elseif(field STREQUAL "time")
      set(args show -s --format=%ct HEAD)
    else()
      set(args status --porcelain --untracked-files=normal)
    endif()
    execute_process(COMMAND "${git}" -C "${SOURCE_DIR}" ${args}
      RESULT_VARIABLE result OUTPUT_VARIABLE ${field} ERROR_VARIABLE error
      OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT result EQUAL 0)
      message(FATAL_ERROR "Cannot inspect Git build identity (${field}): ${error}")
    endif()
  endforeach()
  set(provenance git)
  set(dirty false)
  if(NOT status STREQUAL "")
    set(dirty true)
  endif()
elseif(NOT "${SUPPLIED_COMMIT}${SUPPLIED_TREE}${SUPPLIED_COUNT}${SUPPLIED_TIME}" STREQUAL "")
  # Provenance is a caller assertion, not locally observed Git state. Preserve that
  # distinction; hashes are syntax checked, never interpolated into shell commands.
  string(LENGTH "${SUPPLIED_COMMIT}" commit_length)
  string(LENGTH "${SUPPLIED_TREE}" tree_length)
  if(NOT SUPPLIED_COMMIT MATCHES "^[0-9a-f]+$" OR NOT SUPPLIED_TREE MATCHES "^[0-9a-f]+$"
      OR NOT commit_length MATCHES "^(40|64)$" OR NOT tree_length EQUAL commit_length
      OR NOT SUPPLIED_COUNT MATCHES "^[1-9][0-9]*$" OR NOT SUPPLIED_TIME MATCHES "^(0|[1-9][0-9]*)$")
    message(FATAL_ERROR "Invalid supplied source provenance: full commit, tree, numeric count and commit time are required")
  endif()
  set(commit "${SUPPLIED_COMMIT}")
  set(tree "${SUPPLIED_TREE}")
  set(count "${SUPPLIED_COUNT}")
  set(time "${SUPPLIED_TIME}")
  set(provenance supplied)
endif()
if(NOT commit STREQUAL "")
  if(NOT time MATCHES "^(0|[1-9][0-9]*)$")
    message(FATAL_ERROR "Cannot read the source commit time")
  endif()
  # string(TIMESTAMP) formats SOURCE_DATE_EPOCH instead of the current time.
  set(ENV{SOURCE_DATE_EPOCH} "${time}")
  string(TIMESTAMP year "%Y" UTC)
  string(TIMESTAMP month "%m" UTC)
  string(TIMESTAMP day "%d" UTC)
  unset(ENV{SOURCE_DATE_EPOCH})
  string(REGEX REPLACE "^0" "" month "${month}")
  string(REGEX REPLACE "^0" "" day "${day}")
  math(EXPR year "${year} - 2000")
  math(EXPR date "${month} * 100 + ${day}")
  if(year LESS 26 OR year GREATER 99)
    message(FATAL_ERROR "The source commit date is outside the calendar version years")
  endif()
  set(base "${year}.${date}.${count}")
  string(SUBSTRING "${commit}" 0 12 short_commit)
  set(version "${base}-dev+g${short_commit}")
  set(package_version "${base}~dev+g${short_commit}")
  if(dirty STREQUAL true)
    string(APPEND version ".dirty")
    string(APPEND package_version ".dirty")
  endif()
endif()
# Release labels are assertions about an exact clean Git tag, never free-form
# version overrides. Normal builds keep commit-based development numbering.
if(DEFINED RELEASE_TAG AND NOT RELEASE_TAG STREQUAL "")
  if(NOT RELEASE_TAG MATCHES "^v[2-9][0-9][.][1-9][0-9][0-9][0-9]?[.][1-9][0-9]*(-nightly)?$")
    message(FATAL_ERROR "Invalid release tag: expected vYY.MDD.N or vYY.MDD.N-nightly")
  endif()
  if(NOT provenance STREQUAL "git")
    message(FATAL_ERROR "Release tag requires a Git checkout")
  endif()
  if(dirty)
    message(FATAL_ERROR "Release tag requires a clean Git checkout")
  endif()
  execute_process(COMMAND "${git}" -C "${SOURCE_DIR}" rev-parse --verify "refs/tags/${RELEASE_TAG}^{commit}"
    RESULT_VARIABLE tag_result OUTPUT_VARIABLE tagged_commit ERROR_VARIABLE tag_error
    OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(NOT tag_result EQUAL 0 OR NOT tagged_commit STREQUAL commit)
    message(FATAL_ERROR "Release tag does not identify the current commit")
  endif()
  # The commit count is only meaningful in the full history.
  execute_process(COMMAND "${git}" -C "${SOURCE_DIR}" rev-parse --is-shallow-repository
    RESULT_VARIABLE history_result OUTPUT_VARIABLE shallow OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(NOT history_result EQUAL 0 OR NOT shallow STREQUAL "false")
    message(FATAL_ERROR "Release identity requires full Git history")
  endif()
  if(RELEASE_TAG STREQUAL "v${base}")
    set(package_version "${base}")
  elseif(RELEASE_TAG STREQUAL "v${base}-nightly")
    set(package_version "${base}~nightly")
  else()
    message(FATAL_ERROR "Release tag must be v${base} or v${base}-nightly: the source commit's UTC date and commit count")
  endif()
  string(SUBSTRING "${RELEASE_TAG}" 1 -1 version)
endif()
set(manifest "{\n  \"schemaVersion\": 1,\n  \"version\": \"${version}\",\n  \"baseVersion\": \"${base}\",\n  \"packageVersion\": \"${package_version}\",\n  \"gitCommit\": \"${commit}\",\n  \"gitTree\": \"${tree}\",\n  \"commitCount\": ${count},\n  \"dirty\": ${dirty},\n  \"sourceProvenance\": \"${provenance}\"\n}")
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
configure_file("${CMAKE_CURRENT_LIST_DIR}/BuildInfo.cpp.in" "${OUTPUT_DIR}/BuildInfo.cpp" @ONLY)
file(WRITE "${OUTPUT_DIR}/build-info.json.tmp" "${manifest}\n")
configure_file("${OUTPUT_DIR}/build-info.json.tmp" "${OUTPUT_DIR}/build-info.json" COPYONLY)
file(REMOVE "${OUTPUT_DIR}/build-info.json.tmp")
