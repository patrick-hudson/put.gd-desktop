# cmake -P test_version_mapping.cmake: the Windows version mapping (#396) keeps
# parseReleaseVersion's order. CASE=VERSION runs the mapping for one version, so
# the refusals can be checked in a child.
include("${CMAKE_CURRENT_LIST_DIR}/../cmake/WindowsVersion.cmake")
if(DEFINED CASE)
  putgd_windows_version("${CASE}" V)
  message("${V_FILE_VERSION} ${V_MSI_VERSION}")
  return()
endif()

set(failures 0)
macro(fail text)
  message(SEND_ERROR "${text}")
  math(EXPR failures "${failures} + 1")
endmacro()
# -1, 0 or 1 for two equally long lists of numbers.
function(compare_numbers left right out)
  set(result 0)
  list(LENGTH left n)
  math(EXPR last "${n} - 1")
  foreach(i RANGE ${last})
    list(GET left ${i} a)
    list(GET right ${i} b)
    if(a LESS b)
      set(result -1)
      break()
    elseif(a GREATER b)
      set(result 1)
      break()
    endif()
  endforeach()
  set(${out} ${result} PARENT_SCOPE)
endfunction()

foreach(pair "26.1022.942-nightly;26,1022,0,942;9.176.942" "26.1022.942;26,1022,0,942;9.176.942"
             "28.315.65536;28,315,6,5536;26.121.0" "26.105.1000-dev+g0123456789ab.dirty;26,105,0,1000;0.40.1000")
  list(GET pair 0 version)
  list(GET pair 1 file)
  list(GET pair 2 msi)
  putgd_windows_version("${version}" V)
  if(NOT V_FILE_VERSION STREQUAL file OR NOT V_MSI_VERSION STREQUAL msi)
    fail("${version}: got ${V_FILE_VERSION} and ${V_MSI_VERSION}, expected ${file} and ${msi}")
  endif()
endforeach()

# parseReleaseVersion's order: date, then count, then a nightly before the stable
# release of the same YY.MDD.N (which the numeric fields can't tell apart).
set(ordered
  26.101.1 26.131.99999 26.201.2 26.1022.942-nightly 26.1022.942 26.1022.943-nightly 26.1022.9999 26.1022.10000
  26.1031.65535 26.1101.65534 26.1101.65535 26.1101.65536 26.1101.65537 26.1101.131071 26.1101.131072
  26.1231.200000 27.101.200001 27.1231.300000 28.315.65535 28.315.65536 28.316.70000 30.1022.524287 47.430.524287)
set(previous "")
foreach(version IN LISTS ordered)
  putgd_windows_version("${version}" V)
  string(REPLACE "," ";" file "${V_FILE_VERSION}")
  string(REPLACE "." ";" msi "${V_MSI_VERSION}")
  foreach(field IN LISTS file)
    if(field GREATER 65535)
      fail("${version}: FILEVERSION field ${field} exceeds 16 bits")
    endif()
  endforeach()
  list(GET msi 0 major)
  list(GET msi 1 minor)
  list(GET msi 2 build)
  if(major GREATER 255 OR minor GREATER 255 OR build GREATER 65535)
    fail("${version}: MSI version ${V_MSI_VERSION} exceeds 255.255.65535")
  endif()
  if(previous)
    string(REGEX REPLACE "-.*" "" base "${version}")
    string(REGEX REPLACE "-.*" "" previous_base "${previous}")
    set(want 1)
    if(base STREQUAL previous_base)
      set(want 0)
    endif()
    compare_numbers("${previous_file}" "${file}" got_file)
    compare_numbers("${previous_msi}" "${msi}" got_msi)
    math(EXPR got_file "-(${got_file})")
    math(EXPR got_msi "-(${got_msi})")
    if(NOT got_file EQUAL want OR NOT got_msi EQUAL want)
      fail("${previous} -> ${version}: FILEVERSION ${previous_file} -> ${file}, MSI ${previous_msi} -> ${msi}")
    endif()
  endif()
  set(previous "${version}")
  set(previous_file "${file}")
  set(previous_msi "${msi}")
endforeach()

# Past the mapping, configuration stops instead of producing a lower version.
foreach(version 30.1022.524288 47.501.1 26.1022.12345678 26.1322.1 2026.1022.1)
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DCASE=${version}" -P "${CMAKE_CURRENT_LIST_FILE}" RESULT_VARIABLE code OUTPUT_QUIET ERROR_QUIET)
  if(code EQUAL 0)
    fail("${version} was mapped")
  endif()
endforeach()
if(failures GREATER 0)
  message(FATAL_ERROR "${failures} version mapping checks failed")
endif()
message("Windows version mapping: order and limits hold")
