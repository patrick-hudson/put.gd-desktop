<RCC>
    <qresource prefix="/redesign">
        <file>redesign.qss</file>
        <file alias="fonts/IBMPlexSans-Regular.ttf">fonts/IBMPlexSans-Regular.ttf</file>
        <file alias="fonts/IBMPlexSans-SemiBold.ttf">fonts/IBMPlexSans-SemiBold.ttf</file>
        <file alias="fonts/IBMPlexMono-Regular.ttf">fonts/IBMPlexMono-Regular.ttf</file>
        <file alias="fonts/OFL-sans.txt">fonts/OFL-sans.txt</file>
        <file alias="fonts/OFL-mono.txt">fonts/OFL-mono.txt</file>
</qresource>
</RCC>
