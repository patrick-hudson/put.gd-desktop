QWidget {
    color: %text%;
    font-family: "%UI_FONT%";
    font-size: 14px;
    selection-background-color: %selected%;
    selection-color: %text%;
}
QWidget[redesignRoot="true"], QWidget#putgdWindow {
    background: %bg%;
}
QLabel { background: transparent; border: none; }
QLabel[visualRole="title"] { font-size: 26px; font-weight: 600; }
QLabel[visualRole="sectionTitle"] { font-size: 15px; font-weight: 600; }
QLabel[visualRole="eyebrow"], QLabel[visualRole="railHeading"] {
    color: %textMuted%; font-size: 11px; font-weight: 600;
}
QLabel[visualRole="subtitle"], QLabel[visualRole="muted"],
QLabel[visualRole="binding"], QLabel[visualRole="default"] { color: %textMuted%; }
QLabel[visualRole="secondary"] { color: %textSecondary%; }
QLabel[visualRole="status"] { color: %textSecondary%; background: %surface%; border: 1px solid %border%; border-radius: 7px; padding: 8px 10px; }
QLabel[visualRole="status"][feedbackTone="success"] { color: %success%; background: %surface%; border-color: %success%; }
QLabel[visualRole="status"][feedbackTone="error"] { color: %danger%; background: %surface%; border-color: %danger%; }
QLabel[visualRole="link"], QLabel[visualRole="binding"][bindingTone="active"] { color: %link%; }
QLabel[visualRole="success"], QLabel[feedbackTone="success"] { color: %success%; }
QLabel[visualRole="warning"], QLabel[bindingTone="warning"] { color: %warning%; }
QLabel[visualRole="danger"], QLabel[visualRole="error"],
QLabel[feedbackTone="error"], QLabel[bindingTone="error"] { color: %danger%; }
QWidget[visualRole="mono"], QLabel[visualRole="binding"],
QLineEdit[visualRole="link"], QLineEdit[visualRole="path"],
QPlainTextEdit[visualRole="diagnostics"] { font-family: "%MONO_FONT%"; font-size: 12px; }
QFrame[visualRole="card"], QWidget[visualRole="card"], QGroupBox {
    background: %surface%; border: 1px solid %border%; border-radius: 10px;
}
QFrame[visualRole="separator"] { background: %border%; border: none; max-height: 1px; }
QWidget[visualRole="settingRow"][changed="true"] { background: %selected%; border-radius: 7px; }
QLabel[visualRole="pill"] { background: %selected%; border: 1px solid %borderStrong%; border-radius: 11px; color: %textSecondary%; padding: 3px 9px; font-size: 11px; }
QGroupBox { margin-top: 18px; padding: 18px 14px 12px; }
QGroupBox::title { subcontrol-origin: margin; left: 14px; padding: 0 5px; font-weight: 600; }
QScrollArea, QStackedWidget { background: transparent; border: none; }
QScrollArea > QWidget > QWidget { background: transparent; }
QWidget#mainRail { background: %bg%; border: none; border-right: 1px solid %border%; }
QListWidget#mainNavigation, QListWidget#settingsNavigation {
    background: transparent; border: none; padding: 0; outline: none;
}
QListWidget#mainNavigation::item, QListWidget#settingsNavigation::item {
    border: 1px solid transparent; border-radius: 7px; padding: 11px 12px; margin: 2px 0;
}
QListWidget#mainNavigation::item:selected, QListWidget#settingsNavigation::item:selected { background: %selected%; color: %text%; }
QListWidget#mainNavigation::item:hover, QListWidget#settingsNavigation::item:hover { background: %surface%; }
QListWidget#mainNavigation:focus::item:selected, QListWidget#settingsNavigation:focus::item:selected { border-color: %accent%; }
QWidget#destinationRail { background: %bg%; border: none; border-right: 1px solid %border%; }
QListWidget#destinationList {
    background: transparent; border: none; padding: 0; outline: none;
    qproperty-horizontalScrollBarPolicy: ScrollBarAlwaysOff;
}
QListWidget#destinationList::item { border: 1px solid transparent; border-radius: 9px; padding: 13px 5px; margin: 3px 0; }
QListWidget#destinationList::item:selected { background: %selected%; }
QListWidget#destinationList::item:hover { background: %surface%; }
QListWidget#destinationList:focus::item:selected { border-color: %accent%; }
QPushButton, QToolButton {
    background: transparent; border: 1px solid %borderStrong%; border-radius: 7px;
    min-height: 24px; padding: 4px 12px; font-weight: 400;
}
QPushButton:hover, QToolButton:hover { background: %surfaceRaised%; border-color: %textMuted%; }
QPushButton:pressed, QToolButton:pressed, QToolButton:checked { background: %selected%; }
QPushButton:focus, QToolButton:focus { border: 2px solid %accent%; padding: 3px 11px; }
QPushButton:disabled, QToolButton:disabled { color: %textMuted%; border-color: %border%; background: %surface%; }
QPushButton[visualRole="primary"], QToolButton[visualRole="primary"] { color: %onAccent%; background: %accent%; border-color: %accent%; font-weight: 600; }
QPushButton[visualRole="primary"]:hover, QToolButton[visualRole="primary"]:hover { background: %accentHover%; border-color: %accentHover%; }
QPushButton[visualRole="primary"]:focus, QToolButton[visualRole="primary"]:focus { border-color: %text%; }
QPushButton[visualRole="primary"]:disabled, QToolButton[visualRole="primary"]:disabled { background: %selected%; color: %textMuted%; border-color: %borderStrong%; }
QPushButton[visualRole="danger"], QToolButton[visualRole="danger"] { color: %danger%; border-color: %danger%; background: transparent; }
QPushButton[visualRole="danger"]:hover, QToolButton[visualRole="danger"]:hover { background: %selected%; color: %dangerHover%; border-color: %dangerHover%; }
QPushButton[visualRole="danger"]:focus, QToolButton[visualRole="danger"]:focus { border-color: %accent%; }
QPushButton[visualRole="link"], QToolButton[visualRole="link"] { color: %link%; border-color: transparent; background: transparent; padding: 4px 3px; }
QPushButton[visualRole="link"]:hover, QToolButton[visualRole="link"]:hover { text-decoration: underline; }
QPushButton[visualRole="link"]:focus, QToolButton[visualRole="link"]:focus { border-color: %accent%; padding: 3px 2px; }
QLabel[visualRole="version"] { color: %textMuted%; font-size: 11px; padding: 0 3px; }
QPushButton[visualRole="version"] { color: %textMuted%; font-size: 11px; border-color: transparent; background: transparent; padding: 2px 3px; min-height: 0; text-align: left; }
QPushButton[visualRole="version"]:hover { color: %link%; text-decoration: underline; }
QPushButton[visualRole="version"]:focus { color: %link%; border-color: %accent%; padding: 1px 2px; }
QPushButton#captureRailButton { background: %surface%; text-align: left; padding: 8px 10px; min-height: 24px; }
QPushButton#captureRailButton:hover { background: %surfaceRaised%; }
QPushButton#captureRailButton:focus { border: 2px solid %accent%; padding: 7px 9px; }
QPushButton#captureRailButton[dropTarget="true"] { background: %selected%; border: 2px dashed %accent%; padding: 7px 9px; }
QPushButton#historyEditImage::menu-indicator { image: none; width: 0; }
QToolButton[visualRole="info"] { background: transparent; border: 1px solid transparent; padding: 0; min-height: 0; }
QToolButton[visualRole="info"]:focus { border: 2px solid %accent%; }
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QPlainTextEdit, QTextEdit {
    background: %surfaceRaised%; border: 1px solid %borderStrong%; border-radius: 7px;
    padding: 5px 10px; min-height: 22px; selection-background-color: %accent%; selection-color: %onAccent%;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus,
QPlainTextEdit:focus, QTextEdit:focus { border: 2px solid %accent%; padding: 4px 9px; }
QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled,
QPlainTextEdit:disabled, QTextEdit:disabled { color: %textMuted%; border-color: %border%; background: %surface%; }
QLineEdit[invalid="true"], QComboBox[invalid="true"], QSpinBox[invalid="true"], QDoubleSpinBox[invalid="true"] { border-color: %danger%; }
QLineEdit[warning="true"], QComboBox[warning="true"] { border-color: %warning%; }
QLineEdit[visualRole="editableTitle"] { background: transparent; border: 1px solid transparent; border-bottom: 1px dashed %borderStrong%; border-radius: 0; font-size: 25px; font-weight: 600; padding: 4px 0; }
QLineEdit[visualRole="editableTitle"]:focus { border-bottom: 2px solid %accent%; }
/* Menu-style popup geometry clips styled rows; use the normal list layout. */
QComboBox { padding-right: 28px; combobox-popup: 0; }
QComboBox::drop-down { border: none; width: 24px; }
QComboBox::down-arrow { image: url(%INDICATORS%/chevron.png); width: 12px; height: 12px; }
QComboBox QLineEdit { background: transparent; border: none; padding: 0; min-height: 0; }
QComboBox QAbstractItemView { background: %surfaceRaised%; border: 1px solid %borderStrong%; selection-background-color: %selected%; selection-color: %text%; outline: none; padding: 4px; }
QAbstractSpinBox::up-button, QAbstractSpinBox::down-button { border: none; background: transparent; width: 18px; }
QCheckBox, QRadioButton { spacing: 9px; min-height: 28px; padding: 3px 0; }
QCheckBox::indicator, QRadioButton::indicator { width: 17px; height: 17px; border: 1px solid %borderStrong%; background: %surfaceRaised%; }
QCheckBox::indicator { border-radius: 4px; }
QRadioButton::indicator { width: 18px; height: 18px; border: none; background: transparent; image: url(%INDICATORS%/radio.png); }
QCheckBox::indicator:checked { image: url(%INDICATORS%/check.png); background: %accent%; border-color: %accent%; }
QRadioButton::indicator:checked { image: url(%INDICATORS%/radio-checked.png); }
QCheckBox::indicator:focus { border: 2px solid %accent%; }
QRadioButton:focus { color: %link%; border: 1px solid %accent%; border-radius: 7px; padding: 2px 0; }
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled { border-color: %border%; background: %surface%; }
QTabWidget::pane { background: transparent; border: none; border-top: 1px solid %border%; top: -1px; }
QTabBar { background: transparent; }
QTabBar::tab { background: transparent; color: %textSecondary%; border: none; border-bottom: 2px solid transparent; padding: 12px 15px; margin-right: 8px; }
QTabBar::tab:selected { color: %text%; border-bottom-color: %accent%; }
QTabBar::tab:hover { background: %surface%; }
QTabBar::tab:focus { color: %link%; background: %selected%; }
QListView, QTreeView, QTableView { background: %bg%; alternate-background-color: %surface%; border: none; outline: none; selection-background-color: %selected%; selection-color: %text%; }
QTreeView::item, QTableView::item { border: none; border-bottom: 1px solid %border%; padding: 8px; }
QTreeView::item:focus, QTableView::item:focus { border: 1px solid %accent%; }
QHeaderView::section { background: %surface%; color: %textMuted%; border: none; border-bottom: 1px solid %border%; padding: 8px; font-weight: 600; }
QTableCornerButton::section { background: %surface%; border: none; }
QProgressBar { background: %surfaceRaised%; border: none; border-radius: 4px; color: %textSecondary%; min-height: 7px; text-align: center; }
QProgressBar::chunk { background: %accent%; border-radius: 4px; }
QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle { background: %borderStrong%; border-radius: 4px; min-height: 26px; min-width: 26px; }
QScrollBar::handle:hover { background: %textMuted%; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
QSplitter::handle { background: %border%; }
QMenu, QMessageBox { background: %surface%; }
QMenu { border: 1px solid %borderStrong%; padding: 5px; }
QMenu::item { padding: 8px 22px; border: 1px solid transparent; border-radius: 5px; }
QMenu::item:selected { background: %selected%; border-color: %accent%; }
QMenu::item:disabled { color: %textDisabled%; }
QMenu::item:disabled:selected { background: transparent; border-color: transparent; }
QMenu::separator { background: %border%; height: 1px; margin: 5px 8px; }
QToolTip { background: %surfaceRaised%; color: %text%; border: 1px solid %borderStrong%; padding: 7px; }

QLineEdit[hasUnit="true"] {
    border-right: none; border-top-right-radius: 0; border-bottom-right-radius: 0;
}
QLineEdit[hasUnit="true"]:focus {
    border-right: none; border-top-right-radius: 0; border-bottom-right-radius: 0;
}
QLabel[visualRole="unitSuffix"] {
    background: %surfaceRaised%; color: %textMuted%; border: 1px solid %borderStrong%;
    border-left: none; border-top-right-radius: 7px; border-bottom-right-radius: 7px;
    padding: 4px 8px; min-height: 24px;
}
QPlainTextEdit#historySummary { background: transparent; color: %textMuted%; border: none; border-radius: 0; padding: 0; }
QPlainTextEdit#historySummary:focus { border: 1px solid %accent%; padding: 0; }

QStatusBar { background: %bg%; border-top: 1px solid %border%; }
QStatusBar::item { border: none; }
