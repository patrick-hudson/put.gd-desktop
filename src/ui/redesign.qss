QWidget {
    color: #E7E9EE;
    font-family: "%UI_FONT%";
    font-size: 14px;
    selection-background-color: #232838;
    selection-color: #E7E9EE;
}
QWidget[redesignRoot="true"], QWidget#putgdWindow {
    background: #111317;
}
QLabel { background: transparent; border: none; }
QLabel[visualRole="title"] { font-size: 26px; font-weight: 600; }
QLabel[visualRole="sectionTitle"] { font-size: 15px; font-weight: 600; }
QLabel[visualRole="eyebrow"], QLabel[visualRole="railHeading"] {
    color: #9AA1AD; font-size: 11px; font-weight: 600;
}
QLabel[visualRole="subtitle"], QLabel[visualRole="muted"],
QLabel[visualRole="binding"], QLabel[visualRole="default"] { color: #9AA1AD; }
QLabel[visualRole="secondary"] { color: #C4C9D2; }
QLabel[visualRole="status"] { color: #C4C9D2; background: #181B21; border: 1px solid #2A2F38; border-radius: 7px; padding: 8px 10px; }
QLabel[visualRole="status"][feedbackTone="success"] { color: #4CC38A; background: #181B21; border-color: #4CC38A; }
QLabel[visualRole="status"][feedbackTone="error"] { color: #F07A6A; background: #181B21; border-color: #F07A6A; }
QLabel[visualRole="link"], QLabel[visualRole="binding"][bindingTone="active"] { color: #8DBBFF; }
QLabel[visualRole="success"], QLabel[feedbackTone="success"] { color: #4CC38A; }
QLabel[visualRole="warning"], QLabel[bindingTone="warning"] { color: #E5A443; }
QLabel[visualRole="danger"], QLabel[visualRole="error"],
QLabel[feedbackTone="error"], QLabel[bindingTone="error"] { color: #F07A6A; }
QWidget[visualRole="mono"], QLabel[visualRole="binding"],
QLineEdit[visualRole="link"], QLineEdit[visualRole="path"],
QPlainTextEdit[visualRole="diagnostics"] { font-family: "%MONO_FONT%"; font-size: 12px; }
QFrame[visualRole="card"], QWidget[visualRole="card"], QGroupBox {
    background: #181B21; border: 1px solid #2A2F38; border-radius: 10px;
}
QFrame[visualRole="separator"] { background: #2A2F38; border: none; max-height: 1px; }
QWidget[visualRole="settingRow"][changed="true"] { background: #232838; border-radius: 7px; }
QLabel[visualRole="pill"] { background: #232838; border: 1px solid #343A45; border-radius: 11px; color: #C4C9D2; padding: 3px 9px; font-size: 11px; }
QGroupBox { margin-top: 18px; padding: 18px 14px 12px; }
QGroupBox::title { subcontrol-origin: margin; left: 14px; padding: 0 5px; font-weight: 600; }
QScrollArea, QStackedWidget { background: transparent; border: none; }
QScrollArea > QWidget > QWidget { background: transparent; }
QWidget#mainRail { background: #111317; border: none; border-right: 1px solid #2A2F38; }
QListWidget#mainNavigation, QListWidget#settingsNavigation {
    background: transparent; border: none; padding: 0; outline: none;
}
QListWidget#mainNavigation::item, QListWidget#settingsNavigation::item {
    border: 1px solid transparent; border-radius: 7px; padding: 11px 12px; margin: 2px 0;
}
QListWidget#mainNavigation::item:selected, QListWidget#settingsNavigation::item:selected { background: #232838; color: #E7E9EE; }
QListWidget#mainNavigation::item:hover, QListWidget#settingsNavigation::item:hover { background: #181B21; }
QListWidget#mainNavigation:focus::item:selected, QListWidget#settingsNavigation:focus::item:selected { border-color: #6EA8FE; }
QWidget#destinationRail { background: #111317; border: none; border-right: 1px solid #2A2F38; }
QListWidget#destinationList {
    background: transparent; border: none; padding: 0; outline: none;
    qproperty-horizontalScrollBarPolicy: ScrollBarAlwaysOff;
}
QListWidget#destinationList::item { border: 1px solid transparent; border-radius: 9px; padding: 13px 5px; margin: 3px 0; }
QListWidget#destinationList::item:selected { background: #232838; }
QListWidget#destinationList::item:hover { background: #181B21; }
QListWidget#destinationList:focus::item:selected { border-color: #6EA8FE; }
QPushButton, QToolButton {
    background: transparent; border: 1px solid #343A45; border-radius: 7px;
    min-height: 24px; padding: 4px 12px; font-weight: 400;
}
QPushButton:hover, QToolButton:hover { background: #20242C; border-color: #9AA1AD; }
QPushButton:pressed, QToolButton:pressed, QToolButton:checked { background: #232838; }
QPushButton:focus, QToolButton:focus { border: 2px solid #6EA8FE; padding: 3px 11px; }
QPushButton:disabled, QToolButton:disabled { color: #9AA1AD; border-color: #2A2F38; background: #181B21; }
QPushButton[visualRole="primary"], QToolButton[visualRole="primary"] { color: #111317; background: #6EA8FE; border-color: #6EA8FE; font-weight: 600; }
QPushButton[visualRole="primary"]:hover, QToolButton[visualRole="primary"]:hover { background: #8DBBFF; border-color: #8DBBFF; }
QPushButton[visualRole="primary"]:focus, QToolButton[visualRole="primary"]:focus { border-color: #E7E9EE; }
QPushButton[visualRole="primary"]:disabled, QToolButton[visualRole="primary"]:disabled { background: #232838; color: #9AA1AD; border-color: #343A45; }
QPushButton[visualRole="danger"], QToolButton[visualRole="danger"] { color: #F07A6A; border-color: #F07A6A; background: transparent; }
QPushButton[visualRole="danger"]:hover, QToolButton[visualRole="danger"]:hover { background: #232838; color: #F4A497; border-color: #F4A497; }
QPushButton[visualRole="danger"]:focus, QToolButton[visualRole="danger"]:focus { border-color: #6EA8FE; }
QPushButton[visualRole="link"], QToolButton[visualRole="link"] { color: #8DBBFF; border-color: transparent; background: transparent; padding: 4px 3px; }
QPushButton[visualRole="link"]:hover, QToolButton[visualRole="link"]:hover { text-decoration: underline; }
QPushButton[visualRole="link"]:focus, QToolButton[visualRole="link"]:focus { border-color: #6EA8FE; padding: 3px 2px; }
QPushButton#captureRailButton { background: #181B21; text-align: left; padding: 8px 10px; min-height: 24px; }
QPushButton#captureRailButton:hover { background: #20242C; }
QPushButton#captureRailButton:focus { border: 2px solid #6EA8FE; padding: 7px 9px; }
QPushButton#captureRailButton[dropTarget="true"] { background: #232838; border: 2px dashed #6EA8FE; padding: 7px 9px; }
QPushButton#historyEditImage::menu-indicator { image: none; width: 0; }
QToolButton[visualRole="info"] { background: transparent; border: 1px solid transparent; padding: 0; min-height: 0; }
QToolButton[visualRole="info"]:focus { border: 2px solid #6EA8FE; }
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QPlainTextEdit, QTextEdit {
    background: #20242C; border: 1px solid #343A45; border-radius: 7px;
    padding: 5px 10px; min-height: 22px; selection-background-color: #6EA8FE; selection-color: #111317;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus,
QPlainTextEdit:focus, QTextEdit:focus { border: 2px solid #6EA8FE; padding: 4px 9px; }
QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled,
QPlainTextEdit:disabled, QTextEdit:disabled { color: #9AA1AD; border-color: #2A2F38; background: #181B21; }
QLineEdit[invalid="true"], QComboBox[invalid="true"], QSpinBox[invalid="true"], QDoubleSpinBox[invalid="true"] { border-color: #F07A6A; }
QLineEdit[warning="true"], QComboBox[warning="true"] { border-color: #E5A443; }
QLineEdit[visualRole="editableTitle"] { background: transparent; border: 1px solid transparent; border-bottom: 1px dashed #343A45; border-radius: 0; font-size: 25px; font-weight: 600; padding: 4px 0; }
QLineEdit[visualRole="editableTitle"]:focus { border-bottom: 2px solid #6EA8FE; }
/* Menu-style popup geometry clips styled rows; use the normal list layout. */
QComboBox { padding-right: 28px; combobox-popup: 0; }
QComboBox::drop-down { border: none; width: 24px; }
QComboBox::down-arrow { image: url(:/redesign/chevron.png); width: 12px; height: 12px; }
QComboBox QLineEdit { background: transparent; border: none; padding: 0; min-height: 0; }
QComboBox QAbstractItemView { background: #20242C; border: 1px solid #343A45; selection-background-color: #232838; selection-color: #E7E9EE; outline: none; padding: 4px; }
QAbstractSpinBox::up-button, QAbstractSpinBox::down-button { border: none; background: transparent; width: 18px; }
QCheckBox, QRadioButton { spacing: 9px; min-height: 28px; padding: 3px 0; }
QCheckBox::indicator, QRadioButton::indicator { width: 17px; height: 17px; border: 1px solid #343A45; background: #20242C; }
QCheckBox::indicator { border-radius: 4px; }
QRadioButton::indicator { width: 18px; height: 18px; border: none; background: transparent; image: url(:/redesign/radio.png); }
QCheckBox::indicator:checked { image: url(:/redesign/check.png); background: #6EA8FE; border-color: #6EA8FE; }
QRadioButton::indicator:checked { image: url(:/redesign/radio-checked.png); }
QCheckBox::indicator:focus { border: 2px solid #6EA8FE; }
QRadioButton:focus { color: #8DBBFF; border: 1px solid #6EA8FE; border-radius: 7px; padding: 2px 0; }
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled { border-color: #2A2F38; background: #181B21; }
QTabWidget::pane { background: transparent; border: none; border-top: 1px solid #2A2F38; top: -1px; }
QTabBar { background: transparent; }
QTabBar::tab { background: transparent; color: #C4C9D2; border: none; border-bottom: 2px solid transparent; padding: 12px 15px; margin-right: 8px; }
QTabBar::tab:selected { color: #E7E9EE; border-bottom-color: #6EA8FE; }
QTabBar::tab:hover { background: #181B21; }
QTabBar::tab:focus { color: #8DBBFF; background: #232838; }
QListView, QTreeView, QTableView { background: #111317; alternate-background-color: #181B21; border: none; outline: none; selection-background-color: #232838; selection-color: #E7E9EE; }
QTreeView::item, QTableView::item { border: none; border-bottom: 1px solid #2A2F38; padding: 8px; }
QTreeView::item:focus, QTableView::item:focus { border: 1px solid #6EA8FE; }
QHeaderView::section { background: #181B21; color: #9AA1AD; border: none; border-bottom: 1px solid #2A2F38; padding: 8px; font-weight: 600; }
QTableCornerButton::section { background: #181B21; border: none; }
QProgressBar { background: #20242C; border: none; border-radius: 4px; color: #C4C9D2; min-height: 7px; text-align: center; }
QProgressBar::chunk { background: #6EA8FE; border-radius: 4px; }
QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle { background: #343A45; border-radius: 4px; min-height: 26px; min-width: 26px; }
QScrollBar::handle:hover { background: #9AA1AD; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
QSplitter::handle { background: #2A2F38; }
QMenu, QMessageBox { background: #181B21; }
QMenu { border: 1px solid #343A45; padding: 5px; }
QMenu::item { padding: 8px 22px; border: 1px solid transparent; border-radius: 5px; }
QMenu::item:selected { background: #232838; border-color: #6EA8FE; }
QMenu::item:disabled { color: #6F7682; }
QMenu::item:disabled:selected { background: transparent; border-color: transparent; }
QMenu::separator { background: #2A2F38; height: 1px; margin: 5px 8px; }
QToolTip { background: #20242C; color: #E7E9EE; border: 1px solid #343A45; padding: 7px; }

QLineEdit[hasUnit="true"] {
    border-right: none; border-top-right-radius: 0; border-bottom-right-radius: 0;
}
QLineEdit[hasUnit="true"]:focus {
    border-right: none; border-top-right-radius: 0; border-bottom-right-radius: 0;
}
QLabel[visualRole="unitSuffix"] {
    background: #20242C; color: #9AA1AD; border: 1px solid #343A45;
    border-left: none; border-top-right-radius: 7px; border-bottom-right-radius: 7px;
    padding: 4px 8px; min-height: 24px;
}
QPlainTextEdit#historySummary { background: transparent; color: #9AA1AD; border: none; border-radius: 0; padding: 0; }
QPlainTextEdit#historySummary:focus { border: 1px solid #6EA8FE; padding: 0; }

QStatusBar { background: #111317; border-top: 1px solid #2A2F38; }
QStatusBar::item { border: none; }
