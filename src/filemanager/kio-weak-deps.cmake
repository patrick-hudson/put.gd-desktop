# Writes OUTPUT, a dpkg-shlibdeps shlibs.local naming each KF6 library the built
# KIO plugin NEEDs with no dependency (#2136). The DEB build puts it in the
# staging debian/ folder that CPack runs dpkg-shlibdeps in and removes right
# after (packaging/linux), so it never ships. dpkg-shlibdeps takes shlibs.local
# over the libraries' own symbols files, and an entry without dependencies adds
# none, so the DEB depends on no KDE library.
# Usage: cmake -DPLUGIN=<putgd.so> -DOUTPUT=<shlibs.local> -P kio-weak-deps.cmake
# The project's policies: a script starts with none.
cmake_minimum_required(VERSION 3.24)
find_program(READELF readelf REQUIRED)
execute_process(COMMAND "${READELF}" -d "${PLUGIN}" OUTPUT_VARIABLE dynamic COMMAND_ERROR_IS_FATAL ANY)
string(REGEX MATCHALL "\\(NEEDED\\)[^[]*\\[libKF6[^]]*\\]" needed "${dynamic}")
if(NOT needed)
  message(FATAL_ERROR "${PLUGIN} NEEDs no KF6 library")
endif()
set(text "# Generated by src/filemanager/kio-weak-deps.cmake (#2136): no dependency for these.\n")
foreach(entry IN LISTS needed)
  # shlibs names a library by name and version: libKF6KIOWidgets.so.6 is "libKF6KIOWidgets 6".
  if(NOT entry MATCHES "\\[(libKF6[A-Za-z0-9]+)\\.so\\.([0-9]+)\\]")
    message(FATAL_ERROR "Unexpected KF6 soname in ${entry}")
  endif()
  string(APPEND text "${CMAKE_MATCH_1} ${CMAKE_MATCH_2}\n")
endforeach()
file(WRITE "${OUTPUT}" "${text}")
